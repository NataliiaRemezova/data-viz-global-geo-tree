```{r helpers-and-classify}
#| include: false
# ── Report-wide helper functions ──────────────────────────────────────────────
format_number <- function(x) {
  scales::comma(x, accuracy = 1)
}

format_percent <- function(x) {
  scales::percent(x, accuracy = 0.1)
}

# Applies compact, reproducible wrapping to plot labels only in the PDF output.
# HTML retains the original single-line labels.
plot_labs <- function(title = NULL, subtitle = NULL, ...,
                      title_width = 36, subtitle_width = 50) {
  if (params$latex) {
    if (!is.null(title)) {
      title <- stringr::str_wrap(title, width = title_width)
    }
    if (!is.null(subtitle)) {
      subtitle <- stringr::str_wrap(subtitle, width = subtitle_width)
    }
  }

  ggplot2::labs(title = title, subtitle = subtitle, ...)
}

nice_table <- function(data, caption = NULL) {
  knitr::kable(data, caption = caption, format.args = list(big.mark = ","))
}

sample_up_to <- function(data, n_max) {
  if (nrow(data) <= n_max) {
    return(data)
  }
  set.seed(map_sample_seed)
  dplyr::slice_sample(data, n = n_max)
}

valid_map_points <- function(data) {
  data |>
    filter(
      !is.na(latitude), !is.na(longitude),
      between(latitude, -90, 90), between(longitude, -180, 180)
    )
}

empty_plot <- function(message) {
  ggplot() +
    annotate("text", x = 0, y = 0, label = message, size = 4) +
    theme_void()
}

# ── classify_source() ─────────────────────────────────────────────────────────
# Assigns each raw source name to one of six groups.
# Rules are applied in order — the first matching condition wins.
# Empty sources are rewritten to "unknown source" at load time and land in
# "Other / unknown" via the catch-all, so no separate no-data rule is needed.
classify_source <- function(x) {
  x_lower <- str_to_lower(str_trim(x))
  case_when(
    str_detect(x_lower, "inaturalist|inat")    ~ "iNaturalist",
    str_detect(x_lower, "plantnet|pl@ntnet")   ~ "Pl@ntNet",

    str_detect(x_lower,
      paste0(
        "artportalen|artdatabanken|artsdatabanken|",
        "species observation service|",
        "observation\\.org|waarnemingen|observations\\.be|natagora|",
        "naturgucker|artenfinder|",
        "irecord|bsbi recording|",
        "naturemapr|ozatlas|",
        "laji\\.fi|laji |",
        "arter\\.dk|naturbasen|",
        "flora\\.pt|",
        "inpn|faune-|",
        "species sightings|bioblitz"
      )
    ) ~ "Other citizen-science apps",

    str_detect(x_lower,
      paste0(
        "herbar|museum|botanic|arboretum|",
        "natural history|national collection|herbier national|",
        "inventory|inventaire|census|survey|monitoring|",
        "forest inventory|inventaire forestier|",
        "permanent plot|tree plot|transect|woodland survey|tree register|",
        "classified forest|conservation|protected area|",
        "parc national|national park|",
        "naturalists.? society|ornithological society|",
        "biofokus|onab|for[eê]t de lama|",
        "woody species|wild food plants|",
        "rewilding|reforestation|afforestation|tree planting"
      )
    ) ~ "Institutional & survey data",

    str_detect(x_lower,
      paste0(
        "atlas|flora |floristic|vascular plant|",
        "databank|biodiversit[aä]tsdatenbank|",
        "bsbi|bionet|kastikka|florus|",
        "\\bbien\\b|rainbio|",
        "plants of the world|world checklist|world flora|",
        "tropicos|checklist of|flora of "
      )
    ) ~ "Reference & thematic databases",
    str_detect(x_lower, "wikidata|wikipedia") ~ "Reference & thematic databases",
    str_detect(x_lower,
      "non-native|non native|invasive|alien species|alien plant|weed|biosecurity|exotique"
    ) ~ "Reference & thematic databases",
    str_detect(x_lower,
      paste0(
        "impacto ambiental|estudio de impacto|proyecto|",
        "hidroel[eé]ctrico|interconexi[oó]n|l[ií]nea de transmisi[oó]n|",
        "gasoducto|embalse|plan de manejo|restauraci[oó]n|",
        "minera|aprovechamiento forestal"
      )
    ) ~ "Reference & thematic databases",

    TRUE ~ "Other / unknown"
  )
}
```

# Methodology

This section explains the analytical choices that we implemented throughout the project.

**Data scope.** Rows with missing country codes or species names are removed during loading. Coordinates are converted to numeric values and validated before the continent spatial join; records with missing or out-of-range coordinates, unmatched continents, or open-ocean assignments are excluded from the spatially analysed dataset.

**Source classification.** Each observation carries a free-text source field with thousands of distinct values. A keyword-matching function (`classify_source()`) assigns each source name to one of six groups: iNaturalist, Pl\@ntNet, Other citizen-science apps, Institutional & survey data, Reference & thematic databases, and Other / unknown. The rules are applied in order, and the first match wins. This approach works well for English-language source names and major platforms but can misclassify source names in other languages or those using project-specific abbreviations. The "Other / unknown" group is a catch-all for everything that did not match any rule. This approach is demonstrated in the corresponding report section.

**Geographic boundaries.** For the Germany analysis, administrative boundaries at the NUTS1 level — the federal states (Bundesländer) — and the NUTS3 level (districts) are loaded from GISCO, the geographic information system of the European Commission. Berlin local-area boundaries come from a separate open-data project, listed under sources. If a local copy of these files exists, it is used directly; otherwise the file is downloaded from the public URL on first render.

**Visualisation and subsampling.** The dataset contains more than 6 million observations, so plotting every record would be slow, produce very large files, and add little visual value. Point-based maps therefore use reproducible random subsamples with a fixed seed of 42. Global maps display up to 40,000 observations, while source-specific and density maps use up to 50,000 records per group or map. US and Germany maps use region-specific limits; for Germany, the dataset is often small enough that all observations can be shown. The sampling affects only the visualisations. All counts, rankings, species-richness tables, rarefaction analyses, and source summaries use the full relevant dataset.

# Part I: Global Patterns {.unnumbered}

# Data Preparation

## Data Loading and Cleaning

The CSV file was loaded using `fread()`, which is designed to handle large datasets efficiently.

The text fields were cleaned by removing extra spaces, and columns such as coordinates and years were converted into the correct numeric format.

Records without a country code or species name were excluded.

The coordinates were matched to a world map to identify the continent of each observation.

Two manual corrections were added: Russia was divided at 60°E between Europe and Asia, and Réunion was assigned to Africa.

```{r load-and-clean}
#| cache: true
raw <- fread(observations_path, showProgress = FALSE)

df <- raw |>
  mutate(
    source_raw   = ifelse(
      is.na(source) | str_trim(source) == "",
      "unknown source",
      str_trim(source)
    ),
    source_group = factor(classify_source(source_raw), levels = source_group_levels),
    country_code = str_to_upper(str_trim(country_code)),
    level3_species = str_trim(level3_species),
    level1_family  = str_trim(level1_family),
    level2_genus   = str_trim(level2_genus),
    year      = as.integer(year),
    latitude  = suppressWarnings(as.numeric(latitude)),
    longitude = suppressWarnings(as.numeric(longitude))
  ) |>
  filter(
    !is.na(country_code), country_code != "",
    !is.na(level3_species), level3_species != ""
  )

rm(raw)
```

```{r continent-assignment}
#| cache: true
# Validate coordinates before converting rows to spatial features. Records that
# cannot be assigned spatially would otherwise fail here and are excluded later
# in any case because the report requires a continent assignment.
df <- valid_map_points(df)

coords_unique <- df |>
  distinct(longitude, latitude)

points <- st_as_sf(coords_unique,
                   coords = c("longitude", "latitude"),
                   crs = 4326)

world <- ne_countries(scale = "small", returnclass = "sf")

coords_unique$continent <- st_join(points, world["continent"])$continent

df <- df |>
  left_join(coords_unique, by = c("longitude", "latitude"))
rm(points, coords_unique)

df <- df %>%
  mutate(
    continent = case_when(
      location == "Russian Federation" & longitude < 60 ~ "Europe",
      location == "Russian Federation" & longitude >= 60 ~ "Asia",
      location == "Réunion" & latitude < -20 ~ "Africa",
      TRUE ~ continent
    )
  )

df <- df[!is.na(df$continent), ]
df <- df[df$continent != "Seven seas (open ocean)", ]

data <- df

df_world_map_base <- valid_map_points(df)

df_world_map_sample <- sample_up_to(df_world_map_base, world_map_sample_n)

df_world_map_sample_by_level0 <- df_world_map_base |>
  filter(!is.na(level0), level0 != "") |>
  group_by(level0) |>
  group_modify(~ sample_up_to(.x, world_map_sample_n)) |>
  ungroup()

df_world_map_sample_by_period <- df_world_map_base |>
  mutate(
    periode = case_when(
      year %in% c(2015, 2016) ~ "2015–2016",
      year %in% c(2017, 2018) ~ "2017–2018",
      year %in% c(2019, 2020) ~ "2019–2020",
      year %in% c(2021, 2022) ~ "2021–2022",
      year %in% c(2023, 2024) ~ "2023–2024"
    ),
    periode = factor(periode, levels = period_levels)
  ) |>
  filter(!is.na(periode)) |>
  group_by(periode) |>
  group_modify(~ sample_up_to(.x, world_map_sample_n)) |>
  ungroup()
```

```{r data-summary}
data_summary <- tibble(
  Measure = c(
    "Observation file", "Dataset period", "Rows analysed",
    "Distinct sources", "Distinct source groups", "Distinct countries",
    "Distinct species", "Germany rows"
  ),
  Value = c(
    observations_path,
    paste(start_year, end_year, sep = "–"),
    format_number(nrow(df)),
    format_number(n_distinct(df$source_raw)),
    format_number(n_distinct(df$source_group)),
    format_number(n_distinct(df$country_code)),
    format_number(n_distinct(df$level3_species)),
    format_number(sum(df$country_code == "DE"))
  )
)
nice_table(data_summary)
```

The table above confirms that the dataset loaded correctly and gives an overview of its scope. The analysis uses `r format_number(nrow(df))` observations in total.

## Dataset Overview

::: {.callout-note appearance="minimal"}
*— Anna*
:::

| Column | Description |
|------------------------------------|------------------------------------|
| `sample_id` | Entry ID |
| `country_code` | Code of the country (e.g. US for the USA) |
| `level0` | Broad vegetation category grouping plants by shared ecological and physiological traits (e.g. Evergreen Broadleaf) |
| `level1_family` | Taxonomic Family — a group of related genera sharing common evolutionary characteristics (e.g. Asphodelaceae) |
| `level2_genus` | Taxonomic Genus — a group of closely related species (e.g. Aloe) |
| `level3_species` | Taxonomic Species — the most specific classification level (e.g. Aloe africana) |
| `location` | Country name |
| `source` | Source from which the occurrence record was obtained (e.g. iNaturalist Research-grade Observations) |
| `species_key` | Species identifier |
| `year` | Year of the observation |
| `longitude` | Geographic longitude |
| `latitude` | Geographic latitude |

## Distribution of the data across the world

Data distribution across the different countries:

```{r}
# Count for each country
country_counts <- data %>% count(country_code, sort = TRUE)
# Histogram of the 20 first countries only

country_counts %>% slice_max(n, n = 20) %>% ggplot(aes(x = reorder(country_code, n), y = n)) + geom_col(fill = "steelblue") + coord_flip() + plot_labs( x = "Country", y = "Number of observations", title = "20 most represented countries" )
```

We see that most of the data come from developed western countries, and especially the US that have a very important number of observations compared to the other countries.

Therefore the following research questions arise: is there any evolution of the data collected throughout the years? Do some countries present large imbalance in the data distribution? How could this affect our analysis?

```{r}
#| fig-width: 10
#| fig-height: 6
top20_countries <- data %>% count(country_code, sort = TRUE) %>% slice_head(n = 20)

# Counting of every data for each country per year count(country_code, year)
country_year_counts <- data %>%
  filter(country_code %in% top20_countries$country_code) %>%
  count(country_code, year)

# Order the years : recent -> old
country_year_counts$year <- factor(
  country_year_counts$year,
  levels = sort(unique(country_year_counts$year), decreasing = TRUE)
)

ggplot(country_year_counts, aes(x = reorder(country_code, n, FUN = sum), y = n, fill = year)) + geom_col() + coord_flip() + scale_fill_brewer(palette = "Paired") + plot_labs( x = "Country", y = "Number of observations", fill = "Year", title = "20 most represented countries" ) + theme_gtree() + theme(legend.key.size = unit(0.4, "cm")) + guides(fill = guide_legend(ncol = 2))
```

The graph shows that observations across different countries were collected over a ten-year period. To understand these records in more depth, we analyse their data sources and examine the worldwide distribution of observations in the dataset.

# Source and Platform Bias

::: {.callout-note appearance="minimal"}
*— Nataliia*
:::

In this section of the report we were trying to answer the following research questions:

-   *How many distinct sources are in the dataset, and how can they be grouped?*
-   *Is the dataset dominated by a few platforms, or do many sources contribute evenly?*
-   *What does source concentration mean for the rest of the analysis?*

This section starts from the raw sources column in the dataset and works outwards: first what the column actually contains, then how its thousands of names can be groups, and which sources contribute the most observations, how source composition varies by country and plant family, and whether different sources leave distinct geographic footprints.

## Exploring the Raw Source Field

The `source` column contains free-text entries. The dataset does not specify how many providers contributed records, what types of organisations they are, or whether the same platform is always written in the same way.

Because all later analysis in this section depends on these details, the source field is examined first, before any comparisons are made.

```{r source-field-eda}
# Count every distinct spelling of the source field, including the ones that no
# classification rule will later match. This is deliberately unfiltered: the
# question here is what the raw field contains, not what we can make sense of.
source_raw_counts <- df |>
  count(source_raw, sort = TRUE, name = "observations") |>
  mutate(
    share            = observations / sum(observations),
    cumulative_share = cumsum(share),
    source_rank      = row_number()
  )

n_sources_total <- nrow(source_raw_counts)
share_top10     <- sum(source_raw_counts$share[seq_len(min(10, n_sources_total))])
n_sources_rare  <- sum(source_raw_counts$observations < 100)
share_rare      <- sum(source_raw_counts$share[source_raw_counts$observations < 100])
```

The field contains **`r format_number(n_sources_total)` distinct source names** across `r format_number(nrow(df))` observations. They are not evenly sized: the ten largest names alone account for **`r format_percent(share_top10)`** of all observations, while `r format_number(n_sources_rare)` names contribute fewer than 100 observations each and together make up just `r format_percent(share_rare)` of the data.

```{r source-frequency-profile}
source_size_profile <- source_raw_counts |>
  mutate(
    size_class = cut(
      observations,
      breaks = c(0, 100, 1000, 10000, 100000, Inf),
      labels = c("< 100", "100 – 999", "1,000 – 9,999", "10,000 – 99,999", "≥ 100,000"),
      right  = FALSE
    )
  ) |>
  group_by(size_class) |>
  summarise(
    sources      = n(),
    observations = sum(observations),
    .groups      = "drop"
  ) |>
  mutate(share = observations / sum(observations)) |>
  arrange(desc(size_class)) |>
  transmute(
    `Observations per source` = size_class,
    `Distinct sources`        = format_number(sources),
    `Observations`            = format_number(observations),
    `Share of observations`   = format_percent(share)
  )

nice_table(source_size_profile)
```

This is the main problem: a small number of very large sources provide most observations of the dataset, while hundreds of smaller sources provide only a very small part of it. Therefore, an analysis should not assume that all sources contribute equally. Doing so would focus too much on the many small sources, even though the few large sources have the greatest influence on the results.

```{r top-sources-bar, fig.width=6, fig.height=3.5}
top_sources_raw <- source_raw_counts |>
  slice_head(n = top_n_sources) |>
  mutate(source_short = reorder(str_trunc(source_raw, 45), observations))

ggplot(top_sources_raw, aes(x = source_short, y = observations)) +
  geom_col(fill = "#2171B5", width = 0.72) +
  geom_text(aes(label = format_percent(share)), hjust = -0.08, size = 3.1) +
  coord_flip(clip = "off") +
  scale_y_continuous(labels = comma, expand = expansion(mult = c(0, 0.18))) +
  plot_labs(
    title    = paste0("Top ", top_n_sources, " individual source names"),
    subtitle = "Raw source field, before any classification.",
    x = NULL, y = "Observations",
    caption  = "Percentages are share of all observations. Long names are shortened."
  ) +
  theme_gtree()
```

Reading the actual names is what makes the grouping possible. The most common sources belong to several recurring provider types: two global identification apps, several national observation portals, an aggregator category, forest inventory databases, and floristic archives.

The same provider may appear under different spellings, and some source names are written in languages other than English. Both issues affect the classification method explained in the next section.

## Source Classification

### From Raw Names to Source Groups

The `r format_number(n_sources_total)` distinct source names are too numerous to compare individually. Grouping them makes broader questions answerable, such as whether a pattern is linked to citizen-science apps or formal surveys, although some detail is lost within each group.

The groups were derived from the source names rather than defined in advance. The ten most frequent names already account for `r format_percent(share_top10)` and revealed several recurring provider types. Each type became a group, identified through keywords. The `classify_source()` function applies these rules in order, assigns the first match, and uses a final catch-all category.

Keyword matching is more practical than exact matching because provider names are often inconsistent, for example “iNaturalist”, “iNat”, and “iNaturalist Research-grade Observations”. It also avoids manually listing the `r format_number(n_sources_rare)` rare names.

**GBIF is not one of the groups, even though it is the aggregator every record passed through.** The authors downloaded the entire dataset from GBIF, so the `source` field names the underlying dataset that GBIF re-distributes - "iNaturalist Research-grade Observations", "EOD – eBird Observation Dataset" - and never GBIF itself.

**"Other / unknown"** should not be treated as fully unclassifiable. Multilingual names and project codes may fail to match rules based mainly on English-language terms. The category is therefore examined further rather than discarded.

The resulting six groups (ordered from most to least specific):

-   **iNaturalist** — the largest citizen-science biodiversity platform worldwide.
-   **Pl\@ntNet** — a plant-identification app with a stronger presence in French-speaking countries and the Global South.
-   **Other citizen-science apps** — regional portals (e.g., Artportalen, iRecord, Naturgucker, NatureMapr).
-   **Institutional & survey data** — herbarium/museum collections and systematic field campaigns.
-   **Reference & thematic databases** — compiled floristic atlases, global plant databases (e.g., BIEN, RAINBIO, Tropicos), Wikidata, and invasive-species tracking.
-   **Other / unknown** — everything that did not match any keyword rule.

The table below shows the rules themselves, in the order `classify_source()` evaluates them, together with the largest source names each rule actually captures. The examples are read from the data rather than written by hand, so they stay accurate if the rules or the dataset change.

```{r source-rules-table}
# Two largest real source names per group, so the reader can check the rules
# against what they actually matched.
source_rule_examples <- df |>
  mutate(source_group = as.character(source_group)) |>
  count(source_group, source_raw, sort = TRUE, name = "observations") |>
  group_by(source_group) |>
  slice_head(n = 2) |>
  summarise(
    Examples = paste(str_trunc(source_raw, 38), collapse = "; "),
    .groups  = "drop"
  )

# Rule order mirrors classify_source() and is hand-written: "first match wins"
# is only readable if the table follows evaluation order.  Keep both in sync —
# nothing enforces it.
source_rules <- tibble(
  Order = 1:6,
  `Keyword rule (abridged)` = c(
    "inaturalist, inat",
    "plantnet, pl@ntnet",
    "artportalen, observation.org, naturgucker, irecord, …",
    "herbar, museum, botanic, inventory, survey, monitoring, …",
    paste0(
      "atlas, flora, bien, rainbio, tropicos, wikidata, invasive, ",
      "aprovechamiento forestal, impacto ambiental, …"
    ),
    "— no rule matched —"
  ),
  source_group = c(
    "iNaturalist", "Pl@ntNet",
    "Other citizen-science apps", "Institutional & survey data",
    "Reference & thematic databases", "Other / unknown"
  )
) |>
  left_join(source_rule_examples, by = "source_group") |>
  rename(`Assigned group` = source_group, `Example matched sources` = Examples)

nice_table(source_rules)
```

### Classification coverage

```{r classification-coverage}
coverage_stats <- df |>
  summarise(
    total        = n(),
    n_other      = sum(source_group == "Other / unknown"),
    n_classified = total - n_other,
    coverage     = n_classified / total,
    other_rate   = n_other / total
  )
```

Of all `r format_number(coverage_stats$total)` observations, **`r format_percent(coverage_stats$coverage)`** are assigned to one of the five named groups, and **`r format_percent(coverage_stats$other_rate)`** fall into "Other / unknown". The higher the coverage rate, the more reliably the source-group comparisons throughout this report represent the full dataset.

## Source Concentration

```{r source-concentration-data}
# Count by individual source name — for the Pareto and top-sources charts
source_counts <- df |>
  filter(source_group != "Other / unknown") |>
  count(source_raw, sort = TRUE, name = "observations") |>
  mutate(
    share            = observations / sum(observations),
    cumulative_share = cumsum(share),
    source_rank      = row_number()
  )

# Count by source group — reused throughout the report
source_group_counts <- df |>
  count(source_group, name = "observations") |>
  mutate(share = observations / sum(observations))

# Top source groups by total volume — used in later sections as well
top_source_groups <- source_group_counts |>
  arrange(desc(observations)) |>
  slice_head(n = top_n_sources) |>
  pull(source_group) |>
  as.character()

inat_share    <- source_group_counts$share[source_group_counts$source_group == "iNaturalist"]
citizen_share <- sum(source_group_counts$share[
  source_group_counts$source_group %in%
    c("iNaturalist", "Pl@ntNet", "Other citizen-science apps")
])
```

iNaturalist alone contributes **`r format_percent(inat_share)`** of all observations; the three citizen-science groups together account for **`r format_percent(citizen_share)`**.

```{r source-pareto, fig.width=6, fig.height=3.5}
ggplot(source_counts |> slice_head(n = 50), aes(x = source_rank)) +
  geom_col(aes(y = share), fill = "#2171B5", alpha = 0.75, width = 0.85) +
  geom_line(aes(y = cumulative_share), color = "#C23B22", linewidth = 1) +
  scale_x_continuous(breaks = c(1, 5, 10, 25, 50)) +
  scale_y_continuous(labels = percent, limits = c(0, 1)) +
  plot_labs(
    title    = "Source concentration (Pareto chart)",
    subtitle = "Bars = source share; red line = cumulative. 'Other / unknown' excluded.",
    x = "Source rank", y = "Share of classified observations"
  ) +
  theme_gtree()
```

The Pareto chart shows high source concentration: a small number of sources provide most of the classified observations, and the cumulative share rises quickly. As a result, any consistent bias in the largest sources can strongly affect the full dataset.

```{r source-group-bar, fig.width=6, fig.height=3.5}
ggplot(source_group_counts,
       aes(x = reorder(source_group, observations), y = observations, fill = source_group)) +
  geom_col(width = 0.72, show.legend = FALSE) +
  geom_text(aes(label = format_percent(share)), hjust = -0.08, size = 3.2) +
  coord_flip(clip = "off") +
  scale_y_continuous(labels = comma, expand = expansion(mult = c(0, 0.18))) +
  scale_fill_manual(values = source_colors) +
  plot_labs(
    title    = "Observation share by source group",
    x = NULL, y = "Observations"
  ) +
  theme_gtree()
```

The bar chart also shows that citizen-science platforms provide the largest share of observations, with iNaturalist as the main contributor. Institutional and reference sources are smaller, but they may cover regions and species that citizen-science platforms do not.

## What Is in "Other / Unknown"?

```{r other-source-data}
other_source_top <- df |>
  filter(source_group == "Other / unknown") |>
  count(source_raw, sort = TRUE, name = "observations") |>
  mutate(share_of_other = observations / sum(observations)) |>
  slice_head(n = 8)

n_other_sources <- n_distinct(df$source_raw[df$source_group == "Other / unknown"])
```

"Other / unknown" contains `r format_number(n_other_sources)` individually named sources that did not match any keyword rule. The chart below shows the largest contributors within this heterogeneous catch-all group.

```{r other-source-plot, fig.width=6, fig.height=3}
ggplot(other_source_top,
       aes(x = reorder(str_trunc(source_raw, 45), observations), y = observations)) +
  geom_col(fill = "#2171B5", width = 0.72) +
  geom_text(aes(label = format_percent(share_of_other)), hjust = -0.08, size = 3.1) +
  coord_flip(clip = "off") +
  scale_y_continuous(labels = comma, expand = expansion(mult = c(0, 0.16))) +
  plot_labs(
    title    = "Largest individual sources inside \"Other / unknown\"",
    subtitle = NULL,
    x = NULL, y = "Observations",
    caption  = "Percentages are share of the Other / unknown group, not of the whole dataset."
  ) +
  theme_gtree()
```

## Countries and Regional Coverage

-   *Does source composition vary by country, or are some countries dominated by a single platform?*

When most observations from a country come from one platform, that platform strongly influences the recorded species and locations. The charts below compare the source composition of the most-observed countries and measure how diverse their sources are.

```{r country-source-data}
top_country_values <- df |>
  count(country_code, sort = TRUE) |>
  slice_head(n = top_n_countries) |>
  pull(country_code)

country_source <- df |>
  filter(country_code %in% top_country_values) |>
  mutate(source_group_plot = ifelse(
    as.character(source_group) %in% top_source_groups,
    as.character(source_group), "Other / unknown"
  )) |>
  count(country_code, source_group_plot, name = "observations") |>
  group_by(country_code) |>
  mutate(country_total = sum(observations), share = observations / country_total) |>
  ungroup()

country_order <- country_source |>
  distinct(country_code, country_total) |>
  arrange(country_total) |>
  pull(country_code)

country_source <- country_source |>
  mutate(
    country_code     = factor(country_code, levels = country_order),
    source_group_plot = factor(source_group_plot, levels = source_group_levels)
  )

# Country code -> full name (most frequent location per code), used to build a
# readable key caption for the by-country charts (ISO codes alone are unclear).
country_name_lookup <- df |>
  filter(!is.na(location), location != "") |>
  count(country_code, location, sort = TRUE) |>
  group_by(country_code) |>
  slice_head(n = 1) |>
  ungroup() |>
  select(country_code, location)

# Builds a wrapped "US = United States; DE = Germany; ..." key for chart captions.
make_country_code_key <- function(codes) {
  key <- country_name_lookup |>
    filter(country_code %in% as.character(codes)) |>
    arrange(country_code)
  stringr::str_wrap(
    paste0("Country codes: ",
           paste0(key$country_code, " = ", key$location, collapse = "; ")),
    width = if (params$latex) 60 else 100
  )
}
```

```{r country-source-stacked-share, fig.width=7.5, fig.height=5.5}
ggplot(country_source, aes(x = country_code, y = share, fill = source_group_plot)) +
  geom_col(width = 0.75) +
  coord_flip() +
  scale_y_continuous(labels = percent) +
  scale_fill_manual(values = source_colors, drop = TRUE) +
  plot_labs(
    title    = "Source composition differs by country",
    subtitle = paste0(
      "Top ", top_n_countries,
      " countries by observations; bars sum to 100% within each country."
    ),
    x = NULL, y = "Share of country observations", fill = "Source group",
    caption = make_country_code_key(country_order)
  ) +
  guides(fill = guide_legend(nrow = 2, byrow = TRUE)) +
  theme_gtree() +
  theme(plot.margin = margin(6, 12, 6, 6))
```

The stacked bar chart shows large differences between countries. Some, such as the United States, rely mainly on iNaturalist, while others, including Great Britain and Germany, use a more balanced mix of sources. Countries dominated by one source are more exposed to its geographic and taxonomic biases.

Source diversity is measured using Shannon entropy, converted into an “effective number of source groups.” A value close to 1 means that one source group dominates.

```{r country-diversity-data}
# Shannon entropy -> "effective number of source groups" per country.
shannon_diversity <- function(counts) {
  p <- counts / sum(counts)
  p <- p[p > 0]
  -sum(p * log(p))
}

country_diversity <- df |>
  count(country_code, source_group, name = "observations") |>
  group_by(country_code) |>
  summarise(
    total_observations = sum(observations),
    effective_sources  = exp(shannon_diversity(observations)),
    dominant_source    = as.character(source_group[which.max(observations)]),
    .groups = "drop"
  ) |>
  arrange(desc(total_observations)) |>
  slice_head(n = top_n_countries) |>
  mutate(country_code = factor(country_code, levels = rev(country_code)))
```

```{r source-diversity-country, fig.width=7.5, fig.height=5.5}
ggplot(country_diversity, aes(x = country_code, y = effective_sources, fill = dominant_source)) +
  geom_col(width = 0.72) +
  coord_flip() +
  scale_fill_manual(values = source_colors, drop = TRUE) +
  plot_labs(
    title    = "How source-diverse are the largest country samples?",
    subtitle = "Effective number of source groups is low when one source dominates a country.",
    x = NULL, y = "Effective number of source groups", fill = "Dominant source",
    caption = make_country_code_key(levels(country_diversity$country_code))
  ) +
  guides(fill = guide_legend(nrow = 2, byrow = TRUE)) +
  theme_gtree() +
  theme(plot.margin = margin(6, 12, 6, 6))
```

Countries with low effective source diversity, close to 1, depend almost entirely on a single source. Their recorded species and locations therefore reflect the users and sampling patterns of that platform. Countries with higher source diversity combine several independent data sources, making their results less affected by the biases of any one platform.

Austria, Germany, Spain and Portugal draw on several source groups. In contrast, the US, Canada, Taiwan and New Zealand rely mostly on one source.

## Sources and Taxonomic Groups

-   *Do different sources record different plant families, or is the source mix uniform across plant families?*

When one source type dominates, apparent geographic or temporal patterns may reflect gaps in that source’s coverage rather than real ecological differences.

```{r taxonomic-source-data}
df <- df |> mutate(family_clean = ifelse(level1_family == "" | is.na(level1_family), "Unknown family", level1_family))

top_families <- df |>
  count(family_clean, sort = TRUE) |>
  slice_head(n = top_n_taxa) |>
  pull(family_clean)

family_source <- df |>
  filter(family_clean %in% top_families) |>
  mutate(source_group_plot = ifelse(
    as.character(source_group) %in% top_source_groups,
    as.character(source_group), "Other / unknown"
  )) |>
  count(family_clean, source_group_plot, name = "observations") |>
  group_by(family_clean) |>
  mutate(share = observations / sum(observations)) |>
  ungroup()

family_order <- family_source |>
  group_by(family_clean) |>
  summarise(total = sum(observations)) |>
  arrange(total) |>
  pull(family_clean)

family_source <- family_source |>
  mutate(
    family_clean      = factor(family_clean, levels = family_order),
    source_group_plot = factor(source_group_plot, levels = source_group_levels)
  )
```

```{r taxon-source-share, fig.width=6.5, fig.height=4}
ggplot(family_source, aes(x = family_clean, y = share, fill = source_group_plot)) +
  geom_col(width = 0.75) +
  coord_flip() +
  scale_y_continuous(labels = percent) +
  scale_fill_manual(values = source_colors, drop = TRUE) +
  plot_labs(
    title    = "Source composition by plant family",
    subtitle = "Bars sum to 100% within each taxonomic group.",
    x = NULL, y = "Share of observations", fill = "Source group"
  ) +
  theme_gtree()
```

The source mix differs across plant families. Some families are recorded mainly through citizen-science apps, while others depend more on institutional surveys or reference databases.

iNaturalist is the largest source for all plant families, but its share varies. Some families also receive many records from Pl\@ntNet, reference databases, surveys or other apps.

## Geographic Footprints of Data Sources

-   *Do the major sources cover the same regions, or do they each focus on different parts of the world?*

If sources are geographically complementary, the combined dataset may be broader than any single source. If they overlap heavily, gaps in one source may persist in the whole dataset.

```{r source-map-data}
#| cache: true
map_source_groups <- source_group_counts |>
  filter(!source_group %in% c("Other / unknown")) |>
  arrange(desc(observations)) |>
  slice_head(n = top_n_source_maps) |>
  pull(source_group) |>
  as.character()

map_data_by_source <- df |>
  filter(as.character(source_group) %in% map_source_groups,
         !is.na(latitude), !is.na(longitude),
         between(latitude, -90, 90), between(longitude, -180, 180)) |>
  group_by(source_group) |>
  group_modify(~ sample_up_to(.x, source_map_sample_n)) |>
  ungroup()

world_outline <- ggplot2::map_data("world")
world_outline_plot <- world_outline |>
  filter(region != "Antarctica")
```

```{r source-faceted-map, fig.width=7, fig.height=5}
ggplot() +
  geom_polygon(data = world_outline_plot, aes(x = long, y = lat, group = group),
               fill = "gray96", color = "gray82", linewidth = 0.12, inherit.aes = FALSE) +
  geom_point(data = map_data_by_source, aes(x = longitude, y = latitude),
             alpha = 0.12, size = 0.22, color = "#1F5B74") +
  facet_wrap(~ source_group, ncol = 2) +
  coord_quickmap(xlim = c(-180, 180), ylim = c(-60, 85), expand = FALSE) +
  plot_labs(
    title    = "Geographic coverage of major source groups",
    x = "Longitude", y = "Latitude",
    caption  = "Points show recording locations, not species ranges. Points are sampled for readability."
  ) +
  theme_map_gtree()
```

The faceted map reveals different spatial footprints across source groups. iNaturalist provides the most geographically widespread coverage but is concentrated in North America, Europe, and Oceania. Pl\@ntNet complements it with stronger presence in French-speaking Africa and parts of South America, while still showing high data coverage for Europe. Institutional and survey sources tend to fill in localised regions that citizen-science platforms miss. These differences mean that where the dataset is geographically strong or weak depends directly on which sources are active in a given region.

# Temporal Development

::: {.callout-note appearance="minimal"}
*— Nataliia*
:::

-   *How do observation volume and geographic representation differ by observation year?*
-   *Which sources are associated with the largest increases in dated observations?*

This section traces observations across the dataset time period, decomposes the pattern by source group, and examines whether the geographic footprint broadens or mainly becomes denser.

## Observation Volume Over Time

```{r yearly-counts}
yearly_counts <- df |>
  filter(year >= start_year, year <= end_year) |>
  count(year, name = "observations") |>
  right_join(tibble(year = start_year:end_year), by = "year") |>
  mutate(observations    = ifelse(is.na(observations), 0L, observations)) |>
  arrange(year) |>
  mutate(absolute_change = observations - lag(observations))

growth_summary    <- yearly_counts |> filter(!is.na(absolute_change))
strongest_growth  <- growth_summary |> slice_max(absolute_change, n = 1, with_ties = FALSE)
strongest_decline <- growth_summary |> slice_min(absolute_change, n = 1, with_ties = FALSE)

first_year_count <- yearly_counts$observations[yearly_counts$year == start_year]
last_year_count  <- yearly_counts$observations[yearly_counts$year == end_year]
overall_change   <- (last_year_count - first_year_count) / first_year_count
```

Between `r start_year` and `r end_year`, observations changed from **`r format_number(first_year_count)`** to **`r format_number(last_year_count)`**, an overall change of **`r format_percent(overall_change)`**.

```{r line-observations-by-year, fig.width=6, fig.height=3.5}
ggplot(yearly_counts, aes(x = year, y = observations)) +
  geom_line(color = "#2171B5", linewidth = 1.1) +
  geom_point(color = "#2171B5", size = 2.4) +
  scale_x_continuous(breaks = start_year:end_year) +
  scale_y_continuous(labels = comma) +
  plot_labs(title = "Number of tree observations by year", x = "Year", y = "Observations") +
  theme_gtree()
```

```{r yearly-growth-plot, fig.width=6, fig.height=3.5}
ggplot(growth_summary, aes(x = year, y = absolute_change, fill = absolute_change >= 0)) +
  geom_col(width = 0.72, show.legend = FALSE) +
  geom_hline(yintercept = 0, color = "gray35", linewidth = 0.4) +
  geom_text(
    aes(label = format_number(absolute_change)),
    vjust = ifelse(growth_summary$absolute_change >= 0, -0.35, 1.15),
    size  = 3.1
  ) +
  scale_x_continuous(breaks = start_year:end_year) +
  scale_y_continuous(labels = comma, expand = expansion(mult = c(0.12, 0.16))) +
  scale_fill_manual(values = c("TRUE" = "#2171B5", "FALSE" = "#C23B22")) +
  plot_labs(
    title   = "Year-to-year change in observations",
    x = "Year", y = "Change in observations",
    caption = paste0("Year-to-year changes are calculated within the ", start_year, "–", end_year, " dataset period.")
  ) +
  theme_gtree()
```

The strongest growth occurs in **`r strongest_growth$year`** (+`r format_number(strongest_growth$absolute_change)` observations), and the strongest decline in **`r strongest_decline$year`** (`r format_number(strongest_decline$absolute_change)`).

## Which Sources Drive the Temporal Trend?

```{r source-year-data}
# Observations per year and source group
source_year <- df |>
  filter(year >= start_year, year <= end_year) |>
  mutate(source_group_plot = ifelse(
    as.character(source_group) %in% top_source_groups,
    as.character(source_group), "Other / unknown"
  )) |>
  count(year, source_group_plot, name = "observations") |>
  right_join(
    expand.grid(year = start_year:end_year,
                source_group_plot = source_group_levels),
    by = c("year", "source_group_plot")
  ) |>
  mutate(observations = ifelse(is.na(observations), 0L, observations)) |>
  group_by(year) |>
  mutate(
    share = observations / sum(observations),
    share = ifelse(is.nan(share), 0, share)
  ) |>
  ungroup() |>
  mutate(source_group_plot = factor(source_group_plot, levels = source_group_levels))
```

```{r stacked-area-source-year, fig.width=6, fig.height=3.5}
ggplot(source_year, aes(x = year, y = observations, fill = source_group_plot)) +
  geom_area(alpha = 0.9, linewidth = 0.15, color = "white") +
  scale_x_continuous(breaks = start_year:end_year) +
  scale_y_continuous(labels = comma) +
  scale_fill_manual(values = source_colors, drop = TRUE) +
  plot_labs(
    title    = "Observation volume by source group and year",
    x = "Year", y = "Observations", fill = "Source group"
  ) +
  theme_gtree()
```

The stacked area chart shows that the growth in dated observations is largely linked to citizen-science platforms, especially iNaturalist. As iNaturalist’s contribution increases, the total number of observations rises as well, reflecting changes in platform activity and geographic coverage. Before 2018, observations were distributed more evenly across source groups. The chart also shows a small increase in reference and thematic database records in 2018, followed by a noticeable rise in Pl\@ntNet observations between 2020 and 2022.

```{r source-share-year, fig.width=6, fig.height=3.5}
ggplot(source_year, aes(x = year, y = share, fill = source_group_plot)) +
  geom_col(width = 0.9) +
  scale_x_continuous(breaks = start_year:end_year) +
  scale_y_continuous(labels = percent, expand = expansion(mult = c(0, 0.08))) +
  scale_fill_manual(values = source_colors, drop = TRUE) +
  plot_labs(
    title    = "Source composition by year",
    subtitle = "Bars sum to 100% within each year.",
    x = "Year", y = "Share of observations", fill = "Source group",
    caption  = paste0("Shares are calculated within each year of the ", start_year, "–", end_year, " dataset period.")
  ) +
  theme_gtree() +
  # Centre title and subtitle over the plotting panel so they clear the y-axis label.
  theme(
    plot.title.position = "panel",
    plot.title    = element_text(hjust = 0.5),
    plot.subtitle = element_text(hjust = 0.5)
  )
```

The year-by-year source share view shows whether the source mix is shifting over time. If one source group's share is growing while others shrink, the dataset's overall character is changing — even if total volume increases. A stable composition would suggest that all sources are growing at roughly the same rate.

```{r source-growth-plot, fig.width=6, fig.height=3.5}
largest_source_growth <- source_year |>
  arrange(source_group_plot, year) |>
  group_by(source_group_plot) |>
  mutate(source_change = observations - lag(observations)) |>
  filter(!is.na(source_change)) |>
  slice_max(source_change, n = 1, with_ties = FALSE) |>
  mutate(label = paste0(year, ": ", source_group_plot)) |>
  ungroup()

ggplot(largest_source_growth,
       aes(x = reorder(label, source_change), y = source_change, fill = source_group_plot)) +
  geom_col(width = 0.72, show.legend = FALSE) +
  coord_flip() +
  scale_y_continuous(labels = comma) +
  scale_fill_manual(values = source_colors, drop = TRUE) +
  plot_labs(title = "Largest source-specific yearly increases", x = NULL, y = "Increase from previous year") +
  theme_gtree()
```

The chart above highlights the single largest year-over-year jumps for each source group, making it easy to identify which platforms drove the biggest surges in data volume and when those surges occurred.

## Geographic Coverage Over Time

This subsection examines how the geographic reach of observations dated from 2015 to 2024 differs over time. It compares the first observation year represented for each country within this period and maps observation locations at selected snapshot years.

```{r country-coverage-data}
country_year <- df |>
  filter(year >= start_year, year <= end_year) |>
  count(year, country_code, name = "observations")

country_first_year <- country_year |>
  group_by(country_code) |>
  summarise(first_observed_year = min(year), .groups = "drop")
```

```{r new-countries-plot, fig.width=6, fig.height=3.2}
new_countries <- country_first_year |>
  filter(first_observed_year > start_year) |>
  count(first_observed_year, name = "new_countries") |>
  right_join(tibble(first_observed_year = (start_year + 1):end_year), by = "first_observed_year") |>
  mutate(new_countries = ifelse(is.na(new_countries), 0L, new_countries))

countries_at_start <- sum(country_first_year$first_observed_year == start_year)

ggplot(new_countries, aes(x = first_observed_year, y = new_countries)) +
  geom_col(fill = "#2171B5", width = 0.72) +
  scale_x_continuous(breaks = (start_year + 1):end_year) +
  scale_y_continuous(labels = comma) +
  plot_labs(
    title   = "Countries first represented by observation year",
    x = "First observation year represented in period", y = "Countries",
    caption = paste0(
      start_year, " is excluded: ", countries_at_start,
      " countries already had observations in the first year of the window."
    )
  ) +
  theme_gtree()
```

This chart shows when countries first appear among the observations dated within the selected period. A declining count suggests that later observation years add relatively few countries not already represented by earlier-dated records.

The maps below show observation locations at four snapshot years, revealing whether records spread into new regions or simply become denser in existing ones.

```{r map-snapshots-data}
#| cache: true
snapshot_years_valid <- snapshot_years[snapshot_years >= start_year & snapshot_years <= end_year]

map_data_by_year <- df |>
  filter(year %in% snapshot_years_valid,
         !is.na(latitude), !is.na(longitude),
         between(latitude, -90, 90), between(longitude, -180, 180)) |>
  group_by(year) |>
  group_modify(~ sample_up_to(.x, world_map_sample_n)) |>
  ungroup()
```

```{r map-snapshots-plot, fig.width=7, fig.height=5}
ggplot() +
  geom_polygon(data = world_outline_plot, aes(x = long, y = lat, group = group),
               fill = "gray96", color = "gray82", linewidth = 0.12, inherit.aes = FALSE) +
  geom_point(data = map_data_by_year, aes(x = longitude, y = latitude),
             alpha = 0.15, size = 0.22, color = "#1F5B74") +
  facet_wrap(~ year, ncol = 2) +
  coord_quickmap(xlim = c(-180, 180), ylim = c(-60, 85), expand = FALSE) +
  plot_labs(
    title    = "Map snapshots of observations over time",
    subtitle = "Selected years show whether records spread or intensify in existing regions.",
    x = "Longitude", y = "Latitude",
    caption  = "Points are sampled per year for readability."
  ) +
  theme_map_gtree()
```

Comparing the four snapshot years shows that the geographic footprint of the dated observations was already broadly established early in the period: North America, Europe, and parts of Oceania and South America are visible from the first panel. Later panels show a clear increase in point density within these same regions, but comparatively little expansion into previously unrepresented areas such as central Africa, interior Asia, or the Amazon basin. Within the observation-year window, the pattern is therefore more consistent with intensification than with geographic expansion.

# Taxonomic Composition and Geographic Patterns

## Species observed in this dataset

::: {.callout-note appearance="minimal"}
*— Anna*
:::

What are the different tree families referenced in this dataset?

```{r level0-count-plot}
#| cache: true
#| fig-height: 3.5
#| fig-cap: "Observation counts for the four foliage categories in GlobalGeoTree."
level0_count <- data %>% count(level0, sort = TRUE)

ggplot(level0_count, aes(x = reorder(level0, n), y = n)) + geom_col(fill = "steelblue") + coord_flip() + plot_labs( x = "Plant category", y = "Number of observations", title = "Number of observations for each plant category" ) + theme_gtree()
```

Definition of each tree category:

-   Evergreen Needleleaf: An evergreen needleleaf refers to woody vegetation that retains needle-like or scale-like foliage year-round

-   Evergreen Broadleaf: An evergreen broadleaf is a plant or tree that has wide, flat leaves (rather than needles or scales) and retains its foliage year-round

-   Deciduous Broadleaf: a diverse group of flowering plants (angiosperms) characterized by flat leaves that are shed annually before winter (Oak, Maple, Beech, Birch, and Poplar/Aspen)

-   Deciduous Needleleaf : a unique group of conifers that, unlike their evergreen counterparts, shed all their needles annually in the autumn (rare trees)

Deciduous Broadleaf is the largest foliage category among observations in this dataset. Deciduous Needleleaf accounts for a much smaller share and appears in more geographically restricted areas. These values describe the composition of GlobalGeoTree observations rather than the worldwide abundance of each foliage type.

What are the different taxonomic families represented in this dataset and in which proportion are they represented?

```{r family-count-plot}
#| cache: true
#| fig-cap: "The 20 taxonomic families with the largest observation counts in the dataset."
# The 20 families with the most observations overall.  Rank on the family total,
# not on (level0, family) pairs: a family split across two categories would be
# ranked on each half and could drop out despite a large total.
top20_families <- data %>%
  count(level1_family, sort = TRUE) %>%
  slice_head(n = 20)

# Category breakdown within those 20 families — one row per bar segment.
top20 <- data %>%
  filter(level1_family %in% top20_families$level1_family) %>%
  count(level0, level1_family)

ggplot(
  top20,
  aes(
    x = reorder(level1_family, n, FUN = sum),
    y = n,
    fill = level0
  )
) +
  geom_col() +
  plot_labs(
    x = "Taxonomic family",
    y = "Observations (×100,000)",
    title = "Top 20 Plant Families by Observations",
    fill = "Plant category"
  ) +
  scale_y_continuous(
    labels = scales::label_number(scale = 1 / 100000, accuracy = 0.1)
  ) +
  theme_gtree() +
  # Centre the title over the plotting panel so it clears the y-axis label.
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1),
    plot.title.position = "panel",
    plot.title  = element_text(hjust = 0.5)
  )


```

Again, here we see that the most represented taxonomic families in this dataset are also the most represented ones across the world, especially in North America, Europe and the north of Asia, where most of the data come from. However, as the source bias analysis above shows, this apparent representativeness should be interpreted with caution: the dataset reflects where observers and platforms are most active, not a systematic global survey.

## Geographical distribution of the observations

::: {.callout-note appearance="minimal"}
*— Anna*
:::

How are the trees distributed depending on the latitude?

```{r latitude-distribution-plots}
#| cache: true
ggplot(data, aes(x = latitude)) + geom_histogram(binwidth = 2, fill = "forestgreen", color = "white") + scale_x_reverse() + plot_labs( title = "Distribution of the observations depending on the latitude", x = "Latitude (°)", y = "Number of observations" ) + annotate( "text", x = min(data$latitude, na.rm = TRUE),
    y = -Inf,
    label = "South",
    vjust = 1,
    hjust = 0,
    col="darkgreen"
  ) +
  annotate(
    "text",
    x = max(data$latitude, na.rm = TRUE), y = -Inf, label = "North", vjust = 1, hjust = 1, col="darkgreen" ) + theme_gtree() + coord_cartesian(clip = "off") + theme( plot.margin = margin(10, 10, 30, 10) )

# density curve

ggplot(data, aes(x = latitude)) + geom_density(fill = "forestgreen", alpha = 0.5) + plot_labs( title = "Distribution shape of observations by latitude", x = "Latitude (°)", y = "Relative density" ) + theme_gtree() + annotate( "text", x = min(data$latitude, na.rm = TRUE),
    y = -Inf,
    label = "South",
    vjust = 2,
    hjust = 0,
    col="darkgreen"
  ) +
  annotate(
    "text",
    x = max(data$latitude, na.rm = TRUE), y = -Inf, label = "North", vjust = 2, hjust = 1, col="darkgreen" ) + coord_cartesian(clip = "off") + theme( plot.margin = margin(10, 10, 30, 10) )
```

The histogram preserves absolute observation counts in each latitude interval, while the density curve emphasises the overall distribution shape. Both show substantially more recorded observations in the Northern Hemisphere, which may reflect differences in land area and sampling effort as well as tree distribution.

Larger representations are also often used in ecological studies, because 5° latitudinal bands contain a satisfying amount of information without showing too much noise.

```{r latitude-band-count}
#| cache: true
lat_band <- data %>% mutate(lat_bin = floor(latitude / 5) * 5) %>% count(lat_bin)

ggplot(lat_band, aes(x = lat_bin, y = n)) + geom_col(fill = "steelblue") + plot_labs( title = "Number of observations for each 5° latitude band", x = "Latitude", y = "Number of observations" ) + theme_gtree()
```

The same conclusions can be drawn as before.

We usually take 5° slices because it is small enough to find local tendencies but also big enough to avoid noise and too much non useful information and generally fine enough to reveal geographical patterns (climatic gradients, biodiversity, species distribution, etc.) without creating too much noise.

## Geographical observations of species

::: {.callout-note appearance="minimal"}
*— Anna*
:::

How does latitude influence the different species observed (latitude and species richness)?

```{r global-species-richness-latitude}
#| cache: true
richness <- data %>% mutate(lat_bin = floor(latitude / 5) * 5) %>% group_by(lat_bin) %>% summarise(species_richness = n_distinct(species_key))

ggplot(richness, aes(lat_bin, species_richness)) + geom_line(linewidth = 1) + geom_point() + plot_labs( title = "Recorded species richness by latitude", x = "Latitude", y = "Number of recorded species" ) + theme_gtree()+ scale_x_reverse()
```

Species richness is the number of distinct species recorded in a particular area. Here, recorded richness is higher across many Northern Hemisphere latitude bands and lower near the equator and poles; because observation effort is uneven, this is not a direct estimate of biological richness.

We see here that the maximum species richness are very close in the two hemisphere, but that the distribution is broader in the northern hemisphere than in the southern hemisphere (it is also because trees grow at higher latitudes in the northern hemisphere than in the southern hemisphere). Similar environmental conditions can be found in the two hemispheres but they are not spread following the same pattern.

How does longitude influence the different species observed (longitude and species richness)?

```{r global-species-richness-longitude}
#| cache: true
richness_long <- data %>% mutate(long_bin = floor(longitude / 5) * 5) %>% group_by(long_bin) %>% summarise(species_richness = n_distinct(species_key))

ggplot(richness_long, aes(long_bin, species_richness)) + geom_line(linewidth = 1) + geom_point() + plot_labs( title = "Species richness by longitude", x = "Longitude", y = "Number of species observed" ) + theme_gtree()+ scale_x_reverse()
```

Areas with high recorded species richness correspond to continental areas, but little more can be concluded from longitude alone.

What is the local recorded species richness across the world?

```{r global-richness-grid-map}
#| cache: true
#| fig-cap: "Recorded species richness per 1° grid cell. Counts use all observations; the map shows recorded richness rather than estimated biological richness."
richness_grid <- data %>% 
  mutate( lat_bin = floor(latitude / 1) * 1, long_bin = floor(longitude / 1) * 1 ) %>% group_by(lat_bin, long_bin) %>% summarise( richness = n_distinct(species_key), .groups = "drop" )

world <- if (exists("world_outline_plot")) {
  world_outline_plot
} else {
  ggplot2::map_data("world") |>
    filter(region != "Antarctica")
}

ggplot() + geom_tile( data = richness_grid, aes( x = long_bin + 0.5, y = lat_bin + 0.5, fill = richness ) ) + geom_polygon( data = world, aes(long, lat, group = group), fill = NA, color = "black", linewidth = 0.2 ) + scale_fill_gradientn( colours = c( "yellow", "orange", "darkred" ), name = "Recorded species" ) + coord_fixed(1.3) + plot_labs( title = "Global recorded tree-species richness", x = "Longitude", y = "Latitude" ) + theme_gtree()
```

Within sampled areas, many grid cells show similar recorded richness, while the species involved vary geographically. Observation effort also varies strongly between cells, so the map should not be read as showing homogeneous underlying biodiversity.

How are the different tree species distributed depending on the latitude? Here, we only check for the most represented species.

```{r top-species-latitude}
#| cache: true
# latitude distribution of the 20 most frequent species
top_species <- data %>% count(level3_species, sort = TRUE) %>% slice_head(n = 20)

lat_species <- data %>% filter(level3_species %in% top_species$level3_species) %>% mutate(lat_bin = floor(latitude)) %>% count(level3_species, lat_bin)

ggplot(lat_species, aes(lat_bin, n)) + geom_line() + facet_wrap(~level3_species)
```

With this figure, we see that among the most represented species in this dataset, they present different world distributions. Most of them are mostly present in the northern hemisphere, but some are also present in the southern hemisphere (such as Dombeya acrifolia), and some are almost evenly present in the two hemispheres, such as Cornus acuminata.

Another representation could be a heatmap representing the species depending on the latitude:

```{r top-species-latitude-heatmap}
#| cache: true
top50 <- data %>% count(level3_species, sort = TRUE) %>% slice_head(n = 50)

heat <- data %>% filter(level3_species %in% top50$level3_species) %>% mutate(lat_bin = floor(latitude)) %>% count(level3_species, lat_bin)

ggplot(heat, aes(lat_bin, reorder(level3_species, n), fill = n)) + geom_tile()
```

Again, we see here that most species are present mostly in the northern hemisphere, but some can also be present in both hemisphere or only in the southern hemisphere or near the equator (Guazuma umifolia, a tree largely present in Latin America and really rare in other areas).

boxplot family x latitude

```{r family-latitude-boxplot}
#| cache: true
top20_family <- data %>% count(level1_family, sort = TRUE) %>% slice_head(n = 20)

ggplot( data %>% filter(level1_family %in% top20_family$level1_family), aes(x = reorder(level1_family, latitude, median), y = latitude) ) + geom_boxplot(fill = "steelblue") + coord_flip()
```

Same but on a map. Both maps below use the shared worldwide point-map subsample (see Methodology for subsampling details).

```{r family-map-samples}
#| cache: true
data_sample <- df_world_map_sample

ggplot(data_sample, aes(longitude, latitude)) +
  geom_polygon(data = world, aes(long, lat, group = group), fill = "lightgrey", color = "white", linewidth = 0.2, inherit.aes = FALSE) +
  geom_point(alpha = 0.03, size = 0.05) +
  coord_fixed() +
  plot_labs(caption = paste("Displayed points:", format_number(nrow(data_sample)), "sampled observations.")) +
  theme_gtree()

# one map for each family (20 first families)
top_families <- data %>% count(level1_family, sort = TRUE) %>% slice_head(n = 12) %>% pull(level1_family)

data_top <- df_world_map_base %>%
  filter(level1_family %in% top_families) %>%
  group_by(level1_family) %>%
  group_modify(~ sample_up_to(.x, world_map_sample_n)) %>%
  ungroup()

ggplot(data_top, aes(longitude, latitude)) +
  geom_polygon(data = world, aes(long, lat, group = group), fill = "lightgrey", color = "white", linewidth = 0.2, inherit.aes = FALSE) +
  geom_point(alpha = 0.03, size = 0.05) +
  facet_wrap(~ level1_family) + coord_fixed() + theme_gtree() +
  plot_labs(
    title = "Spatial distribution of the 12 most abundant families",
    caption = paste("Displayed points: up to", format_number(world_map_sample_n), "per family.")
  )
```

On this visualization, we can see the distribution of the different taxonomical families across the world: - families are very widely spread across the world such as the Asteraceae: this family contains a very large amount of different species, that live in temperate areas. They can survive various non-extreme conditions. - families are observed in more restrictive areas, such as the families Ericaceae and Pinaceae: these families are very adapted to cold and unwelcoming places such as the tundra and boreal forests or places that are at a high altitude.

# Worldwide Distribution of the Data

::: {.callout-note appearance="minimal"}
*— Camille*
:::

How are observations distributed globally, and what does this reveal about sampling bias and taxonomic diversity? This section addresses four guiding questions:

1.  Where are observations geographically concentrated, and does the coverage reflect ecological reality or observer activity?
2.  How does the distribution of foliage types vary across latitudes and continents?
3.  How does taxonomic richness compare across continents once differences in sampling effort are accounted for?
4.  Has the spatial coverage of the dataset expanded or merely intensified over the years?

In this section, the aim is to understand how observations are distributed globally, both spatially and temporally. This distribution matters because it directly shapes how the rest of the dataset should be interpreted: an over-representation of certain regions may reflect sampling bias (the activity of contributors in the field) rather than the true state of global tree biodiversity. It is therefore essential to characterize where and when the data was collected, and to identify areas of high and low sampling density. We start by examining the overall geographical spread of observations across continents, before looking more closely at how taxonomic diversity (families, genus, species) is distributed in space. Finally, we analyze how sampling effort has evolved over time, both globally and by continent, to assess whether spatial biases have shifted across the years.

## Pre-Processing

For this analysis, observations are grouped by continent rather than by country. With data spanning more than 210 countries, a country-level analysis would fragment the dataset into categories too small and numerous to reveal meaningful patterns, while a continent-level grouping provides a small number of interpretable regions, each large enough to support robust comparisons of taxonomic diversity and temporal trends. The continent for each observation was derived by spatially joining the point coordinates (longitude, latitude) with a world countries shapefile (rnaturalearth). This approach, however, relies on administrative continent boundaries, which do not always align with the geographical logic relevant to this study. Two adjustments were therefore necessary:

-   Russia is administratively classified as a single entity, but spans two geographical continents. Observations were reassigned to Europe or Asia based on the conventional Ural Mountains boundary (60°E longitude).
-   Réunion Island, despite being a French overseas territory, is geographically located in the Indian Ocean off the African coast, and was therefore reassigned to Africa rather than being grouped with other European territories.

Observations for which no continent could be determined, as well as those located over open ocean (e.g., isolated island territories not covered by the country shapefile), were excluded from the dataset.

The resulting dataset, with the added continent column, is previewed in @tbl-dataset.

```{r}
#| label: tbl-dataset
#| eval: true
#| warning: false
#| message: false
#| tbl-cap: "An overview of the first few rows of the dataset"
#| tbl-cap-location: bottom
#| tbl-height: 3

df_preview <- head(df) |>
  select(sample_id, country_code, level0, level1_family, level2_genus,
         level3_species, source, year, continent)
if (params$latex) {
  kableExtra::kbl(df_preview, booktabs = TRUE, longtable = FALSE) |>
    kableExtra::kable_styling(latex_options = c("scale_down", "hold_position"))
} else {
  kable(df_preview)
}
```

To ensure visual consistency throughout this section, each continent is assigned a fixed color, shown in @fig-couleur-continent. This color scheme is derived from the Okabe-Ito palette, chosen for its colorblind-friendly properties, and is applied consistently across all subsequent maps and charts to facilitate comparison between figures.

```{r}
#| label: fig-couleur-continent
#| eval: true
#| warning: false
#| message: false
#| fig-cap: "Colour scheme used to represent the continents in the following figures"
#| fig-cap-location: bottom
#| fig-height: 1.8
#| fig-width: 10
#| fig-align: center


continent_colors <- c(
  "Africa"        = "#E69F00",  # orange
  "Asia"          = "#D55E00",  # red-orange
  "Europe"        = "#0072B2",  # blue
  "North America" = "#009E73",  # green
  "South America" = "#56B4E9",  # light blue
  "Oceania"       = "#CC79A7"   # purple
)


ggplot(
  data.frame(
    continent = names(continent_colors),
    color = continent_colors
  ),
  aes(x = continent, y = 1, fill = continent)
) +

  geom_tile(width = 0.95, height = 0.8) +

  scale_fill_manual(values = continent_colors) +

  geom_text(
    aes(label = paste0(continent, "\n", color)),
    size = 3.2, vjust = 0.5
  ) +

  theme_void() +

  theme(legend.position = "none")

```

## Global overview

This first subsection provides a global overview of where observations are located. The goal is twofold: first, to visualize the overall spatial coverage of the dataset and assess which regions of the world are represented; second, to quantify this coverage at the continent level in order to detect potential imbalances in sampling effort. @fig-map-continent projects a reproducible subsample of observations on a world map, colored by continent, offering a first visual impression of the dataset's geographical spread without plotting millions of individual points. @fig-bar-continent then complements this map with a quantitative summary, showing the total number of observations recorded per continent. Finally, @fig-density-map goes one step further by highlighting areas of high and low observation density within continents, revealing local concentrations that a simple point map or continent-level count cannot capture on their own. For instance, distinguishing a continent with many observations spread evenly across its territory from one where the same volume of observations is concentrated in a few localized hotspots.

```{r}
#| label: fig-map-continent
#| eval: true
#| warning: false
#| message: false
#| fig-cap: "Geographical projection of observations by continent"
#| fig-cap-location: bottom
#| fig-width: 10
#| fig-align: center


world_map <- if (exists("world_outline_plot")) {
  world_outline_plot
} else {
  map_data("world") |>
    filter(region != "Antarctica")
}


 ggplot() +
   
  geom_polygon(data = world_map,
               aes(long, lat, group = group),
               fill = "grey92", colour = "white", linewidth = 0.1) +
   
  geom_point(data = df_world_map_sample,
             aes(longitude, latitude, colour = continent),
             alpha = 0.15, size = 0.8) +
   
  scale_color_manual(values = continent_colors, guide = "none") +
   
  coord_fixed(1.3, xlim = c(-180, 180), ylim = c(-60, 85)) +
   
  plot_labs(caption = paste("Displayed points:", format_number(nrow(df_world_map_sample)), "of", format_number(nrow(df_world_map_base)), "valid mapped observations.")) +
   
  theme_minimal(base_size = 13)

```

@fig-map-continent shows a strongly uneven geographical coverage of observations. North America (green) and Europe (blue) display a dense, near-continuous coverage, closely following major population centers and road networks (a pattern typical of citizen science platforms like iNaturalist, where sampling effort is driven by observer density rather than tree distribution alone). Asia (orange) covers a considerable geographical extent, but coverage is markedly uneven: it is dense in East Asia, India, and along the Trans-Siberian corridor, yet visibly sparse across Central Asia and Siberia's interior. Africa (yellow) shows a similar contrast, with observations concentrated in South Africa, East Africa, and coastal West Africa, while the Congo Basin and the Sahara remain largely unsampled. South America (light blue) is dominated by coastal Brazil and the Andean corridor, with the Amazon interior almost entirely absent from the dataset despite hosting one of the highest levels of tree biodiversity on Earth. Oceania (pink) is essentially limited to Australia's populated coastline and a scattering of Pacific islands. Overall, this map already suggests that observation density mirrors human accessibility and citizen-science activity more closely than it reflects actual tree biodiversity (a hypothesis further examined in the following density map @fig-density-map).

```{r}
#| label: fig-bar-continent
#| eval: true
#| warning: false
#| message: false
#| fig-cap: "Total number of observations by continent"
#| fig-cap-location: bottom
#| fig-height: 5


df_n_obs <- df %>%
  count(continent, sort = TRUE) %>%
  mutate(
    percentage = n / sum(n),
    label = scales::percent(percentage, accuracy = 0.1)
  )


ggplot(df_n_obs, aes(x = reorder(continent, n), y = n)) +
  
  geom_col(aes(fill = continent)) +
  
  scale_fill_manual(values = continent_colors) +
  
  geom_text(
    aes(label = label),
    hjust = -0.1
  ) +
  
  expand_limits(y = max(df_n_obs$n) * 1.05) +
  
  coord_flip() +
  
  plot_labs(
    x = NULL,
    y = "Nb. obs."
  ) +
  
  theme_gtree() +
  
  theme(legend.position = "none")

```

@fig-bar-continent quantifies the imbalance already suggested by @fig-map-continent. North America and Europe together account for 74.4% of all observations (41.3% and 33.1% respectively), despite representing only a fraction of the world's land area and tree biodiversity. Oceania follows at 10.3%, largely driven by Australia, before a sharp drop to South America (6.6%), Asia (5.5%) and Africa (3.3%). This ranking reveals an important nuance compared to the previous map. Although Asia appeared visually extensive in @fig-map-continent (spanning a wide longitudinal range with a dense cluster of points), it accounts for only 5.5% of total observations, far below Europe or North America. This apparent contradiction is simply a matter of scale: individual points can appear numerous and spread out on a map while still representing a small share of a dataset containing several million observations overall. This illustrates why the two figures are complementary. The map shows where observations are located, while the bar chart shows how much each region actually contributes to the dataset.

```{r}
#| label: fig-density-map
#| eval: true
#| cache: true
#| warning: false
#| message: false
#| fig-cap: "Geographical density of observations"
#| fig-cap-location: bottom
#| fig-width: 10

set.seed(map_sample_seed)
df_density <- df[is.finite(df$longitude) & is.finite(df$latitude), ]
df_density <- df_density[sample(nrow(df_density), min(density_map_sample_n, nrow(df_density))), ]

ggplot() +

  # Base map
  geom_polygon(
    data = world_map,
    aes(x = long, y = lat, group = group),
    fill = "grey90", colour = "white", linewidth = 0.1
  ) +

  # 2D density
  geom_density_2d_filled(
    data = df_density,
    aes(x = longitude, y = latitude),
    contour_var = "ndensity",
    alpha = 0.8
  ) +

  scale_fill_viridis_d(
    option = "cividis",
    name = "Relative density"
  ) +
  
  coord_fixed(1.3, xlim = c(-180, 180), ylim = c(-60, 85)) +
  
  theme_minimal(base_size = 13)

```

*Note: the density estimate is based on a reproducible random subsample of 50,000 observations (drawn with the report-level map seed from the full dataset), rather than all 6.26 million records. Passing the full dataset to `geom_density_2d_filled()` caused a crash in ggplot2 3.5.2 due to memory limitations in the internal stat pipeline. At this sample size, kernel density estimation produces a visually identical result, as the smoothing operation is stable well below this threshold.*

@fig-density-map confirms and refines the pattern already observed in the previous two figures by revealing that observations are not only concentrated on certain continents, but highly clustered within a small number of localized hotspots. The most intense concentration is found in Western Europe (particularly around France, Germany and the United Kingdom), followed closely by the northeastern United States. Secondary hotspots appear along the U.S. West Coast, in Central America, in southeastern Australia, and around Taiwan / southern Japan, while the vast majority of the remaining land surface, including most of Africa, Asia and South America, shows minimal to no density. This concentration pattern reinforces the hypothesis raised earlier: sampling effort appears strongly correlated with population density and citizen-science activity rather than with the underlying distribution of tree biodiversity. Notably, even within high-observation continents such as North America (@fig-bar-continent), density is far from uniform. Most observations are concentrated along the East and West coasts, while large inland areas remain comparatively under-sampled.

Together, these three figures paint a consistent picture. The dataset's geographical coverage reflects observer accessibility and activity far more than actual global tree distribution, a limitation that should be kept in mind, particularly when interpreting taxonomic diversity by continent in the following sections.

## Spatial distribution of foliage types

Having established the overall geographical coverage of the dataset, this subsection shifts focus from where observations occur to what is being observed where. Each tree in the dataset is classified into one of four foliage types (Evergreen Broadleaf, Evergreen Needleleaf, Deciduous Broadleaf, or Deciduous Needleleaf). This classification closely tied to climate, since foliage strategy reflects how trees adapt to seasonal variation in temperature and water availability. The goal is therefore to examine whether these foliage types are distributed uniformly across the sampled regions, or whether they follow the climatic gradients expected from ecological theory, and to what extent this pattern can still be observed despite the sampling bias identified previously.

Three complementary perspectives are used to explore this question. @fig-maps-foliage first projects a reproducible subsample of observations for each foliage type, allowing their geographical range to be visualized directly on a world map. @fig-bar-foliage-continent then aggregates this information into a quantitative comparison, showing how foliage composition varies from one continent to another. Finally, @fig-ridge-latitude moves away from continental boundaries altogether, examining how the density of each foliage type is distributed along a continuous latitudinal gradient. This perspective is particularly relevant here, since climate (and therefore foliage strategy) is primarily structured by latitude rather than by administrative continental divisions.

```{r}
#| label: fig-maps-foliage
#| eval: true
#| cache: true
#| warning: false
#| message: false
#| fig-cap: "Geographical distribution by type of foliage"
#| fig-cap-location: bottom
#| fig-width: 14
#| fig-height: 8
#| fig-align: center


palette_level0 <- c(
  "Deciduous Broadleaf"  = "#E69F00",   
  "Evergreen Broadleaf"  = "#009E73",   
  "Evergreen Needleleaf" = "#0072B2",
  "Deciduous Needleleaf" = "#CC79A7"
)


ggplot() +
  
  geom_polygon(
    data = world_map,
    aes(x = long, y = lat, group = group),
    fill = "grey90", colour = "white", linewidth = 0.1
  ) +
  
  geom_point(
    data = df_world_map_sample_by_level0,
    aes(x = longitude, y = latitude, colour = level0),
    alpha = 0.35, size = 0.6
  ) +
  
  scale_colour_manual(values = palette_level0, guide = "none") +
  
  facet_wrap(~ level0, ncol = 2) +      # two categories per row
  
  coord_fixed(1.3, xlim = c(-180, 180), ylim = c(-60, 85)) +
  
  plot_labs(
    x = NULL, y = NULL,
    caption = paste("Displayed points: up to", format_number(world_map_sample_n), "per foliage type.")
  ) +
  
  theme_minimal(base_size = 12) +
  
  theme(
    panel.grid  = element_blank(),
    strip.text  = element_text(face = "bold", size = 11),
    strip.background = element_rect(fill = "grey94", colour = NA)
  )

```

@fig-maps-foliage reveals that Deciduous Broadleaf (orange) and Evergreen Broadleaf (green) share a broadly similar geographical footprint, both present across nearly all sampled continents and spanning a wide range of latitudes, from temperate to tropical regions. This similarity suggests that, at the continental scale visualized here, geographical presence alone does not clearly separate these two categories. A finer, latitude-based view is needed to detect any underlying climatic gradient between them, which is examined in @fig-ridge-latitude. Evergreen Needleleaf (blue) is most heavily concentrated across the boreal and temperate zones of the Northern Hemisphere (North America, Europe, and northern Asia) but is also present, at lower density, in the southern parts of South America, southern Africa, and Oceania, suggesting an association with temperate conditions more broadly rather than strictly cold northern climates. Deciduous Needleleaf (pink) remains overwhelmingly concentrated at high latitudes, primarily across Siberia and parts of Canada, with only a lower-density secondary presence in the United States and Europe, confirming that, unlike Evergreen Needleleaf, this foliage type stays largely confined to high-latitude regions overall.

```{r}
#| label: fig-bar-foliage-continent
#| eval: true
#| warning: false
#| message: false
#| fig-cap: "Geographical distribution by type of foliage"
#| fig-cap-location: bottom
#| fig-width: 14
#| fig-height: 6
#| fig-align: center


df_level0 <- df %>%
  count(continent, level0, name = "n") %>%
  group_by(continent) %>%
  mutate(pct = n / sum(n) * 100) %>%    # proportion for fair comparison across continents
  ungroup() %>%
  mutate(continent = reorder(continent, n, sum))  # sort by total


ggplot(df_level0, aes(x = continent, y = pct, fill = level0)) +
  
  geom_col(width = 0.7) +
  
  scale_fill_manual(values = palette_level0, name = "Foliage") +
  
  scale_y_continuous(labels = scales::label_percent(scale = 1)) +
  
  coord_flip() +
  
  plot_labs(
    x = NULL, y = "Proportion of observations (%)"
  ) +
  
  theme_minimal(base_size = 12) +
  
  theme(legend.position = "right")

```

@fig-bar-foliage-continent complements the previous maps by quantifying, for each continent, the relative composition of foliage types, independent of each continent's overall sampling volume. A clear contrast emerges between temperate and tropical/subtropical continents. North America and Europe share a similar profile, dominated by Deciduous Broadleaf (around 60–70% of observations), followed by Evergreen Broadleaf as the second-largest category (roughly 25–30%), with Evergreen Needleleaf making up a smaller but still notable share (around 10%), a share not found at comparable levels on any other continent, consistent with the boreal/temperate conifer forests characteristic of these regions. Oceania and Africa, by contrast, are clearly dominated by Evergreen Broadleaf, which accounts for the majority of observations in both continents (over 75% in Oceania, around 60% in Africa), with Deciduous Broadleaf as a smaller secondary category. South America and Asia present an intermediate profile, with Evergreen Broadleaf and Deciduous Broadleaf nearly evenly split at close to 50% each, suggesting that these two continents span a broader mix of climatic zones, from tropical to temperate, rather than being dominated by a single climate regime. Across all four of these continents, Evergreen Needleleaf drops to a marginal share compared to North America and Europe, and Deciduous Needleleaf is nearly absent everywhere except for a very thin presence in North America, Europe, and Asia, consistent with the highly restricted geographical range already observed in @fig-maps-foliage. This continent-level breakdown reinforces the latitudinal pattern suggested by the maps: continents located predominantly at temperate latitudes (North America, Europe) show a foliage composition weighted toward deciduous and needleleaf strategies, while continents dominated by tropical or subtropical land area (Oceania, Africa) are dominated by evergreen broadleaf species, with South America and Asia sitting in between due to their wider climatic range. This distinction by continent, however, remains an approximation, since large countries such as the United States or China span multiple climatic zones. This limitation is directly addressed by @fig-ridge-latitude, which examines this relationship along a continuous latitudinal axis rather than through continental boundaries.

```{r}
#| label: fig-ridge-latitude
#| eval: true
#| warning: false
#| message: false
#| fig-cap: "Distribution of foliage types by latitude"
#| fig-cap-location: bottom
#| fig-width: 14
#| fig-height: 8
#| fig-align: center


# Ridge plot
ggplot(df, aes(x = latitude, y = level0, fill = level0)) +
  
  # Climate reference lines (drawn before the curves so they appear underneath)
  geom_vline(xintercept = 0,    colour = "grey60", linewidth = 0.5, linetype = "solid") +
  geom_vline(xintercept = 23.5, colour = "grey70", linewidth = 0.4, linetype = "dashed") +
  geom_vline(xintercept = -23.5,colour = "grey70", linewidth = 0.4, linetype = "dashed") +
  geom_vline(xintercept = 66.5, colour = "grey70", linewidth = 0.4, linetype = "dashed") +
  
  # Density curves with transparency gradient (gradient under the curve)
  geom_density_ridges(
    aes(fill = level0),
    alpha       = 0.75,
    scale       = 1.8,         # overlap between curves (1 = no overlap)
    rel_min_height = 0.005,    # trims very low-density tails
    bandwidth   = 3,           # smoothing in degrees of latitude
    colour      = "white",
    linewidth   = 0.6
  ) +
  
  # Climate zone annotations
  annotate("text", x = 0,     y = 0, label = "Equator",       angle = 90,
           vjust = 0, hjust=0, size = 3, colour = "grey50") +
  annotate("text", x = 23.5,  y = 0, label = "Tropic of Cancer", angle = 90,
           vjust = -0.4, hjust=0, size = 3, colour = "grey55") +
  annotate("text", x = -23.5, y = 0, label = "Tropic of Capricorn", angle = 90,
           vjust =  1.2, hjust=0, size = 3, colour = "grey55") +
  annotate("text", x = 66.5,  y = 0, label = "Arctic Circle", angle = 90,
           vjust = -0.4, hjust=0, size = 3, colour = "grey55") +
  
  scale_fill_manual(values = palette_level0, guide = "none") +
  
  scale_x_continuous(
    breaks = seq(-60, 80, by = 10),
    labels = function(x) paste0(abs(x), ifelse(x >= 0, "°N", "°S")),
    limits = c(-60, 80)
  ) +
  
  plot_labs(
    x        = "Latitude",
    y        = NULL
  ) +
  
  theme_minimal(base_size = 14) +
  
  theme(
    panel.grid.minor   = element_blank(),
    panel.grid.major.y = element_blank(),
    axis.text.y        = element_text(face = "bold", size = 12),
    plot.caption       = element_text(size = 9, colour = "grey50", hjust = 0)
  )

```

@fig-ridge-latitude refines the patterns suggested by the previous map and bar chart. Evergreen Needleleaf (blue) shows a sharp peak around 45–50°N, with only a small secondary bump around 30–40°S. Deciduous Needleleaf (pink) is similarly concentrated at high northern latitudes, with a pronounced peak around 45–55°N and little recorded presence in the Southern Hemisphere. Deciduous Broadleaf (orange) has a large peak around 45–50°N, while Evergreen Broadleaf (green) is more widely distributed and has a more substantial tropical presence. Unlike the continent-level chart, the ridge plot exposes the continuous latitudinal shape of each category. These patterns are consistent with an association between foliage strategy and climate, but the plot alone cannot establish latitude as the primary driver because observation effort and other environmental variables are not controlled.

## Taxonomic richness by continent

This subsection turns from the spatial and climatic distribution of foliage types to a different question: "how much taxonomic diversity does each continent actually contain ?" This question, however, cannot be answered directly by simply counting the number of distinct species or genera observed per continent, precisely because of the sampling imbalance identified in the first subsection of this report. A continent with more observations is mechanically more likely to have recorded more distinct taxa, even if its underlying biodiversity is not necessarily higher. Comparing raw taxonomic counts between continents therefore risks conflating genuine biodiversity differences with differences in sampling effort alone.

Three complementary views are used to address this issue. @tbl-taxa-continent first reports the raw number of distinct taxa recorded per continent, providing a simple numerical summary of the dataset's taxonomic content. @fig-richness-continent then visualizes these same raw counts as a bar chart, making it easier to compare continents at a glance, while keeping in mind that, at this stage, these values remain directly influenced by each continent's sampling volume, as shown in @fig-bar-continent. Finally, @fig-rarefaction addresses this limitation directly through rarefaction curves, which estimate the expected number of unique species as a function of sample size, allowing continents to be compared on an equal footing regardless of how many observations were actually collected for each.

```{r}
#| label: tbl-taxa-continent
#| eval: true
#| warning: false
#| message: false
#| tbl-cap: "Table of the taxonomic richness by continent"
#| tbl-cap-location: bottom
#| tbl-width: 14
#| tbl-height: 10
#| tbl-align: center


tableau_taxa <- df %>%
  filter(!is.na(continent)) %>%
  group_by(continent) %>%
  summarise(
    Foliage = n_distinct(level0),
    Families = n_distinct(level1_family),
    Genus   = n_distinct(level2_genus),
    Species  = n_distinct(level3_species),
    Complete_taxa = n_distinct(paste(
      level1_family,
      level2_genus,
      level3_species,
      sep = "_"
    )),
    .groups = "drop"
  )


kable(tableau_taxa)

```

```{r}
#| label: fig-richness-continent
#| eval: true
#| warning: false
#| message: false
#| fig-cap: "Taxonomic richness by continent (raw values)"
#| fig-cap-location: bottom
#| fig-width: 14
#| fig-height: 8
#| fig-align: center


richness <- df %>%
  group_by(continent) %>%
  summarise(
    n_families      = n_distinct(level1_family),
    n_genera        = n_distinct(level2_genus),
    n_species       = n_distinct(level3_species),
    n_observations  = n()
  ) %>%
  mutate(
    families_100obs = round(n_families / n_observations * 100, 1),
    genera_100obs   = round(n_genera   / n_observations * 100, 1),
    species_100obs  = round(n_species  / n_observations * 100, 1)
  )

richness_long_raw <- richness %>%
  select(continent, n_families, n_genera, n_species) %>%
  pivot_longer(cols = -continent, names_to = "taxon", values_to = "value") %>%
  mutate(taxon = recode(taxon,
                        n_families = "Families",
                        n_genera   = "Genus",
                        n_species  = "Species"
  ))

# Taxon order and palette consistent with the previous chart
taxon_levels <- c("Families", "Genus", "Species")
palette_taxa <- c("Families" = "#2a78d6", "Genus" = "#1baf7a", "Species" = "#eda100")

richness_long_raw <- richness_long_raw %>%
  filter(!is.na(continent))
richness_long_raw$taxon  <- factor(richness_long_raw$taxon, levels = taxon_levels)


ggplot(richness_long_raw,
                aes(x = reorder(continent, -value), y = value, fill = taxon)) +
  
  geom_col(position = position_dodge(width = 0.8), width = 0.7) +
  
  scale_fill_manual(values = palette_taxa) +
  
  plot_labs(
    x = NULL, y = "Number of unique taxa",
    fill = NULL
  ) +
  
  theme_minimal(base_size = 12) +
  
  theme(
    axis.text.x = element_text(angle = 20, hjust = 1),
    panel.grid.major.x = element_blank(),
    legend.position = "right"
  )

```

@tbl-taxa-continent and @fig-richness-continent report the raw number of distinct taxa recorded per continent, at three taxonomic levels: family, genus, and species. All six continents show a comparable number of families (168–203), suggesting that the dataset captures a broadly similar range of major taxonomic groups everywhere. This similarity breaks down markedly at finer taxonomic resolution : genus counts range from 737 (Europe) to 1219 (North America), and species counts range even more widely, from 2437 (Europe) to 6528 (North America). North America stands out as the richest continent at every taxonomic level, while Europe consistently ranks lowest.

Comparing this ranking to the observation volume documented in @fig-bar-continent reveals an interesting discrepancy. Europe, despite being the second most heavily sampled continent overall (33.1% of observations), records the lowest species richness of all six continents (even lower than Africa and Asia, which together account for less than 9% of total observations). Conversely, South America and Oceania, which together represent under 17% of observations, show species counts (4968 and 4900 respectively) roughly double that of Europe, despite Europe having been sampled nearly four times more intensively.

This pattern suggests that raw taxonomic richness, as shown here, is not simply proportional to sampling volume, but it does not yet establish whether these differences reflect genuine biodiversity patterns or are still partly shaped by uneven sampling effort within each continent. A question addressed directly by the rarefaction analysis in @fig-rarefaction.

**Methodological note:** The `vegan::rarefy()` function calculates the expected number of recorded species in a random sample of *n* observations, drawn without replacement from each continent's species-abundance counts. It evaluates this expectation analytically rather than performing repeated random simulations. Calculating the expectation across increasing sample sizes produces one rarefaction curve per continent. This standardises the number of observations being compared, but it does not correct for geographic coverage, source composition, detectability, or other differences in sampling design.

```{r}
#| label: fig-rarefaction
#| eval: true
#| cache: true
#| warning: false
#| message: false
#| fig-cap: "Rarefaction curves by continent"
#| fig-cap-location: bottom
#| fig-width: 14
#| fig-height: 8
#| fig-align: center


comm_matrix <- df %>%
  st_drop_geometry() %>%                     
  count(continent, level3_species) %>%
  pivot_wider(names_from = level3_species, values_from = n, values_fill = 0) %>% # reshape into a "continent × species" matrix
  column_to_rownames("continent") %>%
  as.matrix()

# Total observations per continent; take the smallest for rarefaction target
min_n <- min(rowSums(comm_matrix))

# Iterate over each continent
rare_df <- purrr::map_dfr(rownames(comm_matrix), function(cont) {
  abund <- comm_matrix[cont, ] # extract the row for this continent
  N <- sum(abund) # total observations for the continent
  ns <- unique(c(seq(1, N, by = max(1, N %/% 60)), N)) # sequence of sample sizes
  S <- rarefy(matrix(abund, nrow = 1), sample = ns) # expected species count when randomly drawing n observations
  tibble(continent = cont, n = ns, S = as.numeric(S))
})

rm(comm_matrix)

ggplot(rare_df, aes(x = n, y = S, color = continent)) +
  
  geom_line(linewidth = 1) +
  
  geom_vline(xintercept = min_n, linetype = "dashed", color = "grey50") +
  
  annotate("text", x = min_n, y = 0,
           label = paste0("n=", min_n),
           vjust = -0.5, hjust = -0.1, size = 3, color = "grey50") +
  
  scale_colour_manual(values = continent_colors) +
  
  plot_labs(
    subtitle = "Dashed line: size of the smallest sample (comparison at equal sampling effort)",
    x = "number of observations",
    y = "Expected unique species",
    color = NULL
  ) +
  
  coord_cartesian(xlim = c(0, 200000)) +
  
  theme_minimal(base_size = 12)

```

@fig-rarefaction provides an equal-observation comparison that substantially revises the picture suggested by the raw counts in @fig-richness-continent. At the shared sampling effort marked by the dashed line (n=198,000, the size of Africa's full sample), the ranking of recorded richness changes considerably. Oceania and South America reach close to 4,000 expected recorded species, followed by Africa (around 3,900). North America and Asia form an intermediate group (roughly 3,700 and 3,400 respectively), while Europe has around 1,300 expected recorded species at this sample size.

The most striking change concerns North America. While it has the highest raw species count in @fig-richness-continent (6,528 species), this advantage largely disappears once observation count is equalised. Its rarefaction curve is overtaken by Oceania, South America, and Africa before reaching the comparison point. This suggests that North America's raw lead is strongly influenced by its larger sample size (@fig-bar-continent), without establishing how the continents compare in underlying biological diversity.

Europe's rarefaction curve remains below the other continents across the range shown. This indicates lower recorded richness even at equal observation counts. The difference may be consistent with ecological patterns, but it may also reflect source composition, geographic concentration, detectability, or other sampling differences that rarefaction does not remove.

Finally, Africa, Oceania, and South America remain fairly closely clustered across the observed range, suggesting comparable recorded richness after standardising observation count. This adjustment addresses sample size rather than all forms of sampling bias.

## Changes in the distribution over time

The two previous subsections examined the spatial and taxonomic distribution of observations as a static snapshot, without considering their recorded year. Given the strong reliance on citizen-science platforms such as iNaturalist, the number and coverage of dated observations are unlikely to be constant across the period. This final subsection therefore examines how observation volume and represented geography differ by observation year. The figures do not show when records were ingested into GlobalGeoTree.

@fig-obs-per-year first tracks the total number of observations dated to each year, alongside the number of distinct countries represented, allowing changes in record volume to be compared with changes in geographic representation.

@fig-obs-per-year-continent then breaks this trend down by continent, revealing whether this growth has been shared evenly across regions or driven primarily by a subset of continents, which would in turn affect the balance of the geographical biases identified earlier.

Finally, @fig-maps-periods brings the temporal and spatial dimensions together, mapping sampled observations over successive two-year periods to directly visualize how the geographical coverage of the dataset has expanded, or remained concentrated, over time.

Taken together, these figures assess whether the spatial imbalances observed in the previous subsections are a stable, structural feature of the dataset, or whether they are progressively narrowing as data collection continues to grow.

```{r}
#| label: fig-obs-per-year
#| eval: true
#| warning: false
#| message: false
#| fig-cap: "Observation volume and represented countries by observation year"
#| fig-cap-location: bottom
#| fig-width: 14
#| fig-height: 8
#| fig-align: center


summary_year <- df %>%
  group_by(year) %>%
  summarise(
    n_obs      = n(),
    n_countries     = n_distinct(country_code),
    .groups    = "drop"
  )

coeff <- max(summary_year$n_obs) / max(summary_year$n_countries)


ggplot(summary_year, aes(x = year)) +
  
  # Bars for observation volume
  geom_col(aes(y = n_obs), fill = "steelblue", alpha = 0.6, width = 0.6) +
  
  # Line for number of distinct countries (secondary axis)
  geom_line(aes(y = n_countries * coeff), colour = "firebrick", linewidth = 1.2) +
  
  geom_point(aes(y = n_countries * coeff), colour = "firebrick", size = 3) +
  
  # Direct annotations on key data points
  geom_text(
    aes(y = n_countries * coeff, label = n_countries),
    vjust = -0.8, colour = "firebrick", size = 3.5, fontface = "bold"
  ) +
  
  scale_x_continuous(breaks = 2015:2024) +
  
  scale_y_continuous(
    name = "Nb. obs.",
    sec.axis = sec_axis(~ . / coeff, name = "Distinct countries (red)")
  ) +
  
  plot_labs(
    x        = "Year"
  ) +
  
  theme_minimal(base_size = 13) +
  
  theme(
    axis.title.y.right = element_text(colour = "firebrick"),
    axis.title.y.left  = element_text(colour = "steelblue")
  )

```

@fig-obs-per-year reveals a marked increase in observations dated from 2018 onward. After remaining between roughly 150,000 and 200,000 observations per year from 2015 to 2018, the count rises sharply and peaks in 2022 at just over 1,000,000. This pattern is consistent with changes in citizen-science activity and source coverage, but observation year alone cannot establish when or why records were added to the combined dataset.

The number of distinct countries represented by dated observations (red line) also increases, from 166 in 2015 to over 198 by 2021, before stabilising around 197–202 through 2024. This broad representation should be interpreted carefully alongside the sharp difference in observation volume: one observation and hundreds of thousands of observations both count as country presence. The chart therefore shows breadth of representation by observation year, not equal sampling within or between countries.

Whether this recent growth in volume has been accompanied by a more even distribution across continents, or remains concentrated in already-dominant regions, is examined more directly in the next figure (@fig-obs-per-year-continent).

```{r}
#| label: fig-obs-per-year-continent
#| eval: true
#| warning: false
#| message: false
#| fig-cap: "Observation volume by continent and observation year"
#| fig-cap-location: bottom
#| fig-width: 14
#| fig-height: 8
#| fig-align: center


summary_continent <- df %>%
  count(year, continent, name = "n")


ggplot(summary_continent, aes(x = year, y = n, colour = continent)) +
  
  geom_line(linewidth = 1.1) +
  
  geom_point(size = 2.5) +
  
  scale_colour_manual(values = continent_colors, name = NULL) +
  
  scale_x_continuous(breaks = 2015:2024) +
  
  plot_labs(
    x = "Year", y = "Nb. obs."
  ) +
  
  theme_minimal(base_size = 13) +
  
  theme(legend.position = "bottom")

```

@fig-obs-per-year-continent refines the pattern in the previous figure. The increase in observations dated since 2018 is concentrated mainly in North America and Europe, while the other four continents remain comparatively flat. North America rises from roughly 20,000 observations dated 2015 to over 450,000 dated 2023, followed by a slight decline in 2024. Europe follows a similar trajectory until 2022 and then declines. Asia, Africa, and Oceania remain at lower levels, while South America has a distinct spike in 2018. These differences show that the imbalance between continents persists across observation years. They may reflect changes in platform activity, source coverage, or the temporal completeness of contributed records rather than changes in tree populations.

```{r}
#| label: fig-maps-periods
#| eval: true
#| cache: true
#| warning: false
#| message: false
#| fig-cap: "Geographical scope of data collection by period (5 two-year periods)"
#| fig-cap-location: bottom
#| fig-width: 16
#| fig-height: 12
#| fig-align: center


df_periode <- df_world_map_sample_by_period


ggplot() +
  
  geom_polygon(
    data = world_map,
    aes(x = long, y = lat, group = group),
    fill = "grey88", colour = "white", linewidth = 0.08
  ) +
  
  geom_point(
    data = df_periode,
    aes(x = longitude, y = latitude, colour = level0),
    alpha = 0.4, size = 0.5
  ) +
  
  scale_colour_manual(values = palette_level0, name = "Foliage") +
  
  facet_wrap(~ periode, ncol = 2) +
  
  coord_fixed(1.3, xlim = c(-180, 180), ylim = c(-60, 85)) +
  
  plot_labs(
    x = NULL, y = NULL,
    caption = paste("Displayed points: up to", format_number(world_map_sample_n), "per two-year period.")
  ) +
  
  theme_minimal(base_size = 11) +
  
  theme(
    panel.grid       = element_blank(),
    legend.position  = "bottom",
    strip.text       = element_text(face = "bold"),
    strip.background = element_rect(fill = "grey94", colour = NA)
  ) +
  
  guides(colour = guide_legend(
    override.aes = list(alpha = 1, size = 3)   # makes the legend readable despite low alpha
  ))

```

@fig-maps-periods provides a direct spatial confirmation of the trends identified in the two previous figures, while also introducing an additional dimension: foliage type (Evergreen Broadleaf, Evergreen Needleleaf, Deciduous Broadleaf). Across all five sampled period panels, the overall geographical footprint of the dataset remains remarkably stable. The same broad regions (North America, Europe, coastal South America, parts of Africa and Southeast Asia/Oceania) are already represented as early as 2015–2016, with no major new region appearing in later periods. This is consistent with the near-total country coverage observed in @fig-obs-per-year: geographical breadth was established early, and subsequent growth in volume (@fig-obs-per-year-continent) has taken the form of densification within already-sampled areas rather than expansion into new ones. This densification is visually apparent when comparing early and recent periods: point coverage becomes progressively denser and more continuous over North America and Europe, particularly for deciduous broadleaf (orange) and evergreen broadleaf (green) foliage, while regions such as central Africa, the Amazon interior, and Central Asia remain visibly sparse throughout all five periods, showing little to no improvement over the decade.

Overall, this final figure shows that the geographic imbalance is visible throughout the full range of observation years. This is consistent with a persistent structural bias in the dated records, while not describing when the contributing records were actually ingested into GlobalGeoTree.

# Part II: Germany and Berlin Analysis {.unnumbered}

::: {.callout-note appearance="minimal"}
*— Nataliia*
:::

Part II examines tree observations within Germany.

```{r de-helpers}
#| include: false
# ── Germany-specific helper functions ─────────────────────────────────────────

# Shortens raw source names to readable labels for bar charts
make_source_label <- function(source) {
  source <- stringr::str_squish(as.character(source))
  dplyr::case_when(
    stringr::str_detect(source, stringr::regex("Pl@ntNet automatically", ignore_case = TRUE)) ~ "Pl@ntNet auto ID",
    stringr::str_detect(source, stringr::regex("Pl@ntNet observations", ignore_case = TRUE)) ~ "Pl@ntNet observations",
    stringr::str_detect(source, stringr::regex("iNaturalist", ignore_case = TRUE)) ~ "iNaturalist research-grade",
    stringr::str_detect(source, stringr::regex("Observation\\.org", ignore_case = TRUE)) ~ "Observation.org",
    stringr::str_detect(source, stringr::regex("naturgucker", ignore_case = TRUE)) ~ "naturgucker",
    stringr::str_detect(source, stringr::regex("ArtenFinder", ignore_case = TRUE)) ~ "ArtenFinder",
    is.na(source) | source == "" ~ "Unknown source",
    TRUE ~ stringr::str_trunc(source, width = 35)
  )
}

# Reads a GeoJSON boundary file from a local path or downloads it from a URL
read_geojson_local_or_url <- function(local_path, url, label) {
  source_note <- paste("No", label, "boundary file was loaded.")
  x <- NULL

  if (file.exists(local_path)) {
    x <- try(sf::st_read(local_path, quiet = TRUE), silent = TRUE)
    source_note <- paste("Loaded", label, "boundaries from", local_path)
  } else {
    download_result <- try(
      utils::download.file(url, local_path, quiet = TRUE, mode = "wb"),
      silent = TRUE
    )
    if (!inherits(download_result, "try-error") && file.exists(local_path)) {
      x <- try(sf::st_read(local_path, quiet = TRUE), silent = TRUE)
      source_note <- paste("Downloaded", label, "boundaries from public source")
    }
  }

  if (inherits(x, "try-error") || is.null(x)) {
    return(list(data = NULL, note = source_note))
  }

  x <- sf::st_make_valid(x) |> sf::st_transform(4326)
  names(x) <- tolower(gsub("[^A-Za-z0-9]+", "_", trimws(names(x))))
  names(x) <- gsub("^_+|_+$", "", names(x))
  names(x) <- make.unique(names(x), sep = "_")
  list(data = x, note = source_note)
}

simplify_for_plot <- function(x, tolerance = 0.01) {
  if (is.null(x) || nrow(x) == 0) {
    return(x)
  }
  simplified <- try(
    sf::st_simplify(x, dTolerance = tolerance, preserveTopology = TRUE),
    silent = TRUE
  )
  if (inherits(simplified, "try-error")) {
    return(x)
  }
  sf::st_make_valid(simplified)
}

# ── Map-plotting function ─────────────────────────────────────────────────────

# Smooth filled density contours (no individual points)
plot_filled_density_map <- function(points_data, boundary_data = NULL,
                                    title, subtitle, caption = NULL,
                                    xlim = NULL, ylim = NULL,
                                    bins = 9, alpha = 0.88) {
  p <- ggplot()
  if (!is.null(boundary_data)) {
    p <- p + geom_sf(data = boundary_data, fill = "gray98", color = "gray75", linewidth = 0.25)
  }
  p <- p +
    stat_density_2d_filled(data = points_data,
                           aes(x = longitude, y = latitude, fill = after_stat(level)),
                           contour_var = "density", bins = bins, alpha = alpha)
  if (!is.null(boundary_data)) {
    p <- p + geom_sf(data = boundary_data, fill = NA, color = "gray35", linewidth = 0.35)
  }
  if (!is.null(xlim) && !is.null(ylim)) {
    p <- p + coord_sf(xlim = xlim, ylim = ylim, expand = FALSE)
  } else {
    p <- p + coord_sf(expand = FALSE)
  }
  p + scale_fill_viridis_d(
    option = "D", direction = -1, name = "Density",
    guide = guide_legend(
      nrow = 2, keywidth = 0.7, keyheight = 0.5,
      label.theme = element_text(size = 6)
    )
  ) +
    plot_labs(title = title, subtitle = subtitle, caption = caption) +
    theme_map_gtree()
}

# ── Spatial helper functions ──────────────────────────────────────────────────

# Extracts a single Bundesland boundary by name pattern
get_bundesland_boundary <- function(bundeslaender_data, name_pattern) {
  if (is.null(bundeslaender_data) || nrow(bundeslaender_data) == 0) return(NULL)
  boundary <- bundeslaender_data |>
    filter(stringr::str_detect(stringr::str_to_lower(bundesland), name_pattern))
  if (nrow(boundary) == 0) NULL else boundary
}

# Prepares NUTS3 district polygons for a given state prefix
prepare_nuts3_districts <- function(nuts3_data, nuts_prefix, fallback_label) {
  if (is.null(nuts3_data) || nrow(nuts3_data) == 0) return(NULL)
  nuts3_clean <- nuts3_data
  if (!("nuts_id" %in% names(nuts3_clean)) && "id" %in% names(nuts3_clean)) {
    nuts3_clean$nuts_id <- as.character(nuts3_clean$id)
  }
  if (!("nuts_id" %in% names(nuts3_clean))) {
    nuts3_clean$nuts_id <- NA_character_
  }
  name_col <- intersect(c("name_latn", "nuts_name", "name", "nuts_id"), names(nuts3_clean))[1]
  if (is.na(name_col)) {
    nuts3_clean$district_name <- paste(fallback_label, seq_len(nrow(nuts3_clean)))
  } else {
    nuts3_clean$district_name <- as.character(nuts3_clean[[name_col]])
  }
  districts <- nuts3_clean |>
    filter(stringr::str_starts(as.character(nuts_id), nuts_prefix), as.character(nuts_id) != nuts_prefix) |>
    mutate(district_id = as.character(nuts_id)) |>
    select(district_id, district_name, geometry)
  if (nrow(districts) == 0) NULL else districts
}

# Filters observations to a state using spatial join (preferred) or bounding box (fallback)
filter_state_observations <- function(points_sf, fallback_data, boundary_data, fallback_bbox,
                                      boundary_note, fallback_note) {
  if (!is.null(boundary_data) && nrow(boundary_data) > 0) {
    # Preferred: use the official boundary polygon for an exact spatial join
    state_sf <- sf::st_join(points_sf, boundary_data |> select(geometry),
                            join = sf::st_within, left = FALSE)
    filter_note <- boundary_note
  } else {
    # Fallback: use a bounding box when boundary files are unavailable
    state_data <- fallback_data |>
      filter(dplyr::between(longitude, fallback_bbox$lon_min, fallback_bbox$lon_max),
             dplyr::between(latitude, fallback_bbox$lat_min, fallback_bbox$lat_max))
    state_sf <- sf::st_as_sf(state_data, coords = c("longitude", "latitude"), crs = 4326, remove = FALSE)
    filter_note <- fallback_note
  }
  list(
    sf = state_sf,
    data = state_sf |> sf::st_drop_geometry() |> tibble::as_tibble(),
    note = filter_note
  )
}

# Creates a summary table for a regional subset
make_state_summary <- function(data, region_label, filter_note) {
  tibble::tibble(
    metric = c(
      paste(region_label, "filtering method"),
      paste(region_label, "observations"),
      paste(region_label, "recorded species"),
      paste(region_label, "recorded genera"),
      paste(region_label, "recorded families"),
      "Available source values",
      "Available years"
    ),
    value = c(
      filter_note,
      format_number(nrow(data)),
      format_number(n_distinct(data$level3_species[!is.na(data$level3_species) & data$level3_species != ""])),
      format_number(n_distinct(data$level2_genus[!is.na(data$level2_genus) & data$level2_genus != ""])),
      format_number(n_distinct(data$level1_family[!is.na(data$level1_family) & data$level1_family != ""])),
      format_number(n_distinct(data$source_raw[!is.na(data$source_raw) & data$source_raw != ""])),
      if (nrow(data) == 0 || all(is.na(data$year))) "No usable year values"
      else paste(range(data$year, na.rm = TRUE), collapse = "–")
    )
  )
}

# Counts observations per source and formats for bar charts
make_source_counts <- function(data) {
  data |>
    mutate(source_short = make_source_label(source_raw)) |>
    count(source_short, name = "observations", sort = TRUE) |>
    mutate(
      share = observations / sum(observations),
      label = paste0(format_number(observations), " (", format_percent(share), ")"),
      source_short = factor(source_short, levels = rev(source_short))
    )
}

# Joins observations to district polygons and computes per-district counts
make_district_outputs <- function(region_data, district_boundaries) {
  if (is.null(district_boundaries) || nrow(district_boundaries) == 0 || nrow(region_data) == 0) {
    return(list(counts = tibble::tibble(), map = NULL))
  }
  region_sf <- sf::st_as_sf(region_data, coords = c("longitude", "latitude"), crs = 4326, remove = FALSE)
  joined <- sf::st_join(region_sf, district_boundaries |> select(district_id, district_name, geometry),
                         join = sf::st_within, left = FALSE) |>
    sf::st_drop_geometry() |> tibble::as_tibble()
  counts <- joined |>
    filter(!is.na(district_name), district_name != "") |>
    group_by(district_id, district_name) |>
    summarise(observations = n(), species = n_distinct(level3_species),
              sources = n_distinct(source_raw), .groups = "drop") |>
    arrange(desc(observations))
  map <- district_boundaries |>
    left_join(counts, by = c("district_id", "district_name")) |>
    mutate(observations = dplyr::coalesce(observations, 0L),
           species = dplyr::coalesce(species, 0L),
           sources = dplyr::coalesce(sources, 0L))
  list(counts = counts, map = map)
}

# Adds a human-readable species display name by looking up English common names
# from the GBIF lookup table. Falls back to Latin name if no common name is found.
add_species_display_name <- function(data) {
  # Build GBIF lookup if the cached common-names table exists
  gbif_lookup <- if (exists("species_common_names") && nrow(species_common_names) > 0) {
    species_common_names |> dplyr::select(level3_species, common_name_en)
  } else {
    tibble::tibble(level3_species = character(), common_name_en = character())
  }

  data |>
    left_join(gbif_lookup, by = "level3_species") |>
    mutate(
      species_display_name = dplyr::case_when(
        !is.na(common_name_en) & common_name_en != "" ~
          paste0(common_name_en, " (", level3_species, ")"),
        TRUE ~ level3_species
      ),
      display_common_name_en = common_name_en
    )
}

```

```{r de-data-prep}
#| cache: true
# Filter to Germany and ensure valid coordinates for mapping
germany <- df |>
  filter(country_code == "DE",
         !is.na(latitude), !is.na(longitude),
         between(latitude, -90, 90), between(longitude, -180, 180))

germany_points <- sf::st_as_sf(germany, coords = c("longitude", "latitude"), crs = 4326, remove = FALSE)
```

```{r de-input-summary}
de_input_summary <- tibble::tibble(
  item = c("Total observations (all countries)", "Germany observations used in Part II"),
  value = c(format_number(nrow(df)), format_number(nrow(germany)))
)
nice_table(de_input_summary, "Germany data check")
```

# Germany: Species and Common-Name Lookup

To make charts easier to read, English common names are shown next to Latin names wherever possible. The GlobalGeoTree dataset contains `species_key`, a unique GBIF identifier for each species. This key is used to query the GBIF vernacular-names API once and cache the result in `data/external/species_common_names.csv`. On every subsequent render, the report reads from that file.

```{r germany-species-count}
german_species_for_names <- germany |>
  filter(!is.na(level3_species), level3_species != "") |>
  group_by(level3_species, species_key) |>
  summarise(de_observations = n(), .groups = "drop") |>
  arrange(desc(de_observations))

species_count_summary <- tibble::tibble(
  metric = c("Unique species in German observations", "Species with a valid GBIF species key"),
  value = c(
    format_number(n_distinct(german_species_for_names$level3_species)),
    format_number(sum(!is.na(german_species_for_names$species_key) &
                        german_species_for_names$species_key != ""))
  )
)
nice_table(species_count_summary, "German species overview")
```

```{r fetch-species-names}
species_names_path <- file.path(external_data_path, "species_common_names.csv")

if (!file.exists(species_names_path)) {
  if (!requireNamespace("jsonlite", quietly = TRUE)) {
    stop("Install jsonlite to fetch species names: install.packages('jsonlite')")
  }

  species_with_key <- german_species_for_names |>
    filter(!is.na(species_key), species_key != "")

  # Fetches the first English common name for a species from the GBIF API.
  # A small delay (0.08s) is added between requests to avoid overloading the API.
  fetch_en_name <- function(key) {
    url <- paste0("https://api.gbif.org/v1/species/", key, "/vernacularNames?limit=30")
    resp <- tryCatch(jsonlite::fromJSON(url, simplifyDataFrame = TRUE), error = function(e) NULL)
    Sys.sleep(0.08)
    if (is.null(resp) || !is.data.frame(resp$results) || nrow(resp$results) == 0) return(NA_character_)
    en <- resp$results$vernacularName[resp$results$language == "eng"]
    if (length(en) == 0) return(NA_character_)
    en[1]
  }

  species_with_key$common_name_en <- vapply(species_with_key$species_key, fetch_en_name, character(1))
  write.csv(species_with_key, species_names_path, row.names = FALSE)
}

species_names_raw <- read.csv(species_names_path, stringsAsFactors = FALSE) |> tibble::as_tibble()
species_common_names <- species_names_raw |>
  select(level3_species, common_name_en) |>
  filter(!is.na(common_name_en), common_name_en != "")

fetch_names_status <- tibble::tibble(
  metric = c("Species queried from GBIF", "Species with an English common name"),
  value = c(format_number(nrow(species_names_raw)), format_number(nrow(species_common_names)))
)
nice_table(fetch_names_status, "GBIF common names lookup result")
```

Species without an English name in GBIF are shown with their Latin name only in charts.

# Germany: National Patterns

This section examines how tree observations are distributed across Germany as a whole: spatial concentration, temporal trends, source structure, and federal state-level variation.

## Pre-Processing

Polygons for the federal states (Bundesländer) are needed to draw state boundaries on Germany maps and to assign observations to states. The code first looks for a local GeoJSON file; if it is not found, the public GISCO NUTS1 file is downloaded. Individual state names throughout this part follow the GISCO boundary file, which uses the German forms (Bayern, Niedersachsen, and so on), so that the text and the figures agree.

```{r load-bundeslaender}
#| cache: true
bundeslaender_result <- read_geojson_local_or_url(
  bundeslaender_local_path, gisco_nuts1_url, "federal state / NUTS1"
)
bundeslaender <- bundeslaender_result$data

if (!is.null(bundeslaender)) {
  if ("cntr_code" %in% names(bundeslaender)) {
    bundeslaender <- bundeslaender |> filter(as.character(cntr_code) == "DE")
  }
  if ("levl_code" %in% names(bundeslaender)) {
    bundeslaender <- bundeslaender |> filter(as.character(levl_code) == "1")
  }
  name_col <- intersect(c("name_latn", "nuts_name", "name", "nuts_id"), names(bundeslaender))[1]
  if (is.na(name_col)) {
    bundeslaender$bundesland <- paste("Federal state", seq_len(nrow(bundeslaender)))
  } else {
    bundeslaender$bundesland <- as.character(bundeslaender[[name_col]])
  }
  bundeslaender <- bundeslaender |>
    select(bundesland, geometry) |>
    filter(!is.na(bundesland), bundesland != "")
}

has_bundeslaender <- !is.null(bundeslaender) && nrow(bundeslaender) > 0
bundeslaender_plot <- simplify_for_plot(bundeslaender, tolerance = 0.01)

bundeslaender_status <- tibble::tibble(
  item = c("Boundary status", "Number of federal state polygons"),
  value = c(bundeslaender_result$note, ifelse(has_bundeslaender, format_number(nrow(bundeslaender)), "0"))
)
nice_table(bundeslaender_status, "Federal state boundary check")
```

```{r load-nuts3}
#| cache: true
nuts3_result <- read_geojson_local_or_url(nuts3_local_path, gisco_nuts3_url, "NUTS3")
nuts3 <- nuts3_result$data
```

## Distribution of observations in Germany

-   *Where are observations spatially concentrated across Germany?*

Two complementary views are shown below. @fig-de-density is a smooth filled density surface, which highlights where observations concentrate into hotspots; @fig-de-points plots the individual observation points the surface is derived from, revealing the raw recording locations behind those contours.

```{r germany-distribution-data}
germany_points_for_maps <- sample_up_to(germany, max_germany_overview_points)
germany_boundary_for_maps <- if (has_bundeslaender) dplyr::bind_rows(bundeslaender_plot) else NULL
```

```{r}
#| label: fig-de-density
#| fig-cap: "Smoothed density of Germany observations"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 5
if (nrow(germany_points_for_maps) < 3) {
  empty_plot("Not enough Germany observations were available for the distribution maps.")
} else {
  plot_filled_density_map(
    points_data = germany_points_for_maps,
    boundary_data = germany_boundary_for_maps,
    title = NULL,
    subtitle = NULL,
    caption = NULL,
    xlim = germany_xlim, ylim = germany_ylim, bins = 10, alpha = 0.90
  )
}
```

Darker areas show where more observations were recorded. **This is the central caveat for the whole of Part II: every map, chart and count that follows measures recording intensity, not tree abundance.** A location can appear dense because observers are active there, because a platform has strong coverage, or simply because access is easier. Nothing in this dataset distinguishes a place with many trees from a place with many observers, so the two must not be read as the same thing.

Recording is highest in western and southwestern Germany, with a separate strong hotspot around Berlin. Large parts of eastern and northeastern Germany have much lower density.

```{r}
#| label: fig-de-points
#| fig-cap: "Locations of Germany observations"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 5
if (nrow(germany_points_for_maps) < 3) {
  empty_plot("Not enough Germany observations were available for the distribution maps.")
} else {
  p <- ggplot()
  if (!is.null(germany_boundary_for_maps)) {
    p <- p + geom_sf(data = germany_boundary_for_maps, fill = "gray98", color = "gray70", linewidth = 0.25)
  }
  p +
    geom_point(data = germany_points_for_maps, aes(x = longitude, y = latitude),
               alpha = 0.4, size = 0.02, color = "gray25") +
    coord_sf(xlim = germany_xlim, ylim = germany_ylim, expand = FALSE) +
    plot_labs(caption = NULL) +
    theme_map_gtree()
}
```

@fig-de-points confirms the same pattern: observations cluster strongly in the west and south, while the east is more sparsely covered outside Berlin.

## Observations by year

-   *How has recording activity changed over time in Germany?*

```{r}
#| label: fig-de-year
#| fig-cap: "Germany observations by year"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 3.5
year_counts <- germany |>
  filter(!is.na(year), year >= 1900, year <= as.integer(format(Sys.Date(), "%Y"))) |>
  count(year, name = "observations") |>
  arrange(year)

if (nrow(year_counts) == 0) {
  empty_plot("No usable year values were found in the Germany rows.")
} else {
  ggplot(year_counts, aes(x = year, y = observations)) +
    geom_col(width = 0.75, fill = "steelblue") +
    geom_line(linewidth = 0.6, color = "gray25") +
    geom_point(size = 1.8, color = "gray25") +
    scale_x_continuous(breaks = scales::pretty_breaks()) +
    scale_y_continuous(labels = scales::comma_format()) +
    plot_labs(x = "Year", y = "Observations") +
    theme_gtree()
}
```

Recording grows steeply through the second half of the period, which is common in citizen-science datasets as more users join the platforms. Volume peaks in **`r year_counts$year[which.max(year_counts$observations)]`** and then falls over the final two years.

That decline is most likely an artefact of how the dataset was assembled rather than a real collapse in German recording. Every record reaches GlobalGeoTree through GBIF, and there is a lag between an observation being made, being verified on a platform, and appearing in a GBIF snapshot — so the most recent years are still filling up. Part III points the same way: the U.S. series in @fig-us-obs-per-year climbs to its highest level at the very end of the same decade. Germany and the United States are unlikely to have diverged that sharply in the same two years, so the drop is better read as incomplete coverage at the cutoff than as a fall in activity.

## Source footprints across Germany

-   *Which platforms contribute the most records in Germany, and do they cover the country differently?*

@fig-de-year shows *when* Germany observations were recorded; this subsection examines *who* recorded them. Each panel of @fig-de-source-map shows where one source collected its records.

Note that "source" here means an individual platform, not one of the six source groups defined by `classify_source()` in Part I. Germany is dominated by so few platforms that the individual names are more informative than the groups; the five largest are shown separately and everything else is pooled into "Other sources".

```{r de-source-groups}
source_counts_de <- germany |>
  count(source_raw, name = "observations", sort = TRUE) |>
  mutate(share = observations / sum(observations), source_short = make_source_label(source_raw))

top_sources_de <- source_counts_de |> slice_head(n = 5) |> pull(source_raw)

germany_sources <- germany |>
  mutate(
    source_display = if_else(source_raw %in% top_sources_de, make_source_label(source_raw), "Other sources"),
    source_display = stringr::str_wrap(source_display, width = 20)
  )

# Counts for the bar chart
de_source_counts <- germany_sources |>
  count(source_display, name = "observations", sort = TRUE) |>
  mutate(
    share = observations / sum(observations),
    label = paste0(format_number(observations), " (", format_percent(share), ")"),
    source_display = factor(source_display, levels = rev(source_display))
  )

source_map_data_de <- germany_sources |>
  group_by(source_display) |>
  group_modify(~ sample_up_to(.x, max_points_per_source_group)) |>
  ungroup() |>
  mutate(source_display = factor(source_display, levels = levels(de_source_counts$source_display)))
```

```{r}
#| label: fig-de-source-map
#| fig-cap: "Source footprints in Germany"
#| fig-cap-location: bottom
#| fig-width: 7
#| fig-height: 5
p <- ggplot()
if (has_bundeslaender) {
  p <- p + geom_sf(data = bundeslaender_plot, fill = "gray97", color = "gray70", linewidth = 0.2)
}
p +
  geom_point(data = source_map_data_de, aes(x = longitude, y = latitude),
             alpha = 0.20, size = 0.45, color = "#1F5B74") +
  facet_wrap(~ source_display, ncol = 3) +
  coord_sf(xlim = germany_xlim, ylim = germany_ylim, expand = FALSE) +
  plot_labs(
    caption = paste("Maximum displayed points per source:", format_number(max_points_per_source_group))
  ) +
  theme_map_gtree()
```

@fig-de-source-map shows clear differences in where each source records observations. Observation.org and Pl\@ntNet are more concentrated in western and southern Germany, while naturgucker and iNaturalist have broader national coverage. Pl\@ntNet auto ID appears the most evenly spread, although the `r format_number(max_points_per_source_group)`-point limit per panel means these show coverage patterns rather than total record numbers.

## Observations by source

@fig-de-source-map shows *where* each source records; @fig-de-source-bar shows *how many* records each source contributes.

```{r}
#| label: fig-de-source-bar
#| fig-cap: "Germany observations by source"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 3.5
ggplot(de_source_counts, aes(x = source_display, y = observations)) +
  geom_col(fill = "steelblue") +
  geom_text(aes(label = label), hjust = -0.05, size = 3) +
  coord_flip() +
  scale_y_continuous(labels = scales::comma_format(), expand = expansion(mult = c(0, 0.20))) +
  plot_labs(subtitle = NULL, x = NULL, y = "Observations") +
  theme_gtree()
```

Pl\@ntNet auto ID contributes `r format_percent(de_source_counts$share[1])` of all German records — almost half. iNaturalist research-grade and Observation.org add another `r format_percent(sum(de_source_counts$share[2:3]))`, so the three largest sources together account for `r format_percent(sum(de_source_counts$share[1:3]))` of the dataset. The remaining sources make much smaller contributions, meaning national patterns are shaped mainly by these three platforms.

This inverts the global picture. Part I showed that iNaturalist alone contributes `r format_percent(inat_share)` of all observations worldwide and is by some margin the largest single source. In Germany it is only the second largest, behind an automated identification pipeline. Germany is therefore not a scaled-down version of the global dataset: whichever platform happens to have market share in a given country determines what its records look like, and conclusions drawn at one geographic scale do not transfer to another.

`Pl@ntNet observations` and `Pl@ntNet auto ID` are both Pl\@ntNet-derived but represent different validation routes: one is the regular shared-observation dataset, and the other contains automatically identified occurrences. They are therefore kept separate throughout this report.

## Observations mapped to federal states

-   *How are observations distributed across Germany's sixteen federal states?*

Observations are assigned to federal states using a spatial join — each observation's coordinates are matched to the boundary polygon it falls within.

```{r bundesland-spatial-join}
#| cache: true
if (has_bundeslaender) {
  # Spatial join: assign each observation to the Bundesland whose polygon contains it
  germany_bundeslaender <- sf::st_join(germany_points, bundeslaender, left = FALSE, join = sf::st_within) |>
    sf::st_drop_geometry() |> tibble::as_tibble()
  germany_bundeslaender_n <- nrow(germany_bundeslaender)

  # Aggregate: count observations, species, and sources per Bundesland
  bundesland_counts <- germany_bundeslaender |>
    group_by(bundesland) |>
    summarise(observations = n(), species = n_distinct(level3_species),
              sources = n_distinct(source_raw), .groups = "drop") |>
    arrange(desc(observations))

  # Join counts back to the boundary polygons for the choropleth map
  bundesland_map <- bundeslaender |>
    left_join(bundesland_counts, by = "bundesland") |>
    mutate(observations = dplyr::coalesce(observations, 0L),
           species = dplyr::coalesce(species, 0L),
           sources = dplyr::coalesce(sources, 0L))
  bundesland_map_plot <- simplify_for_plot(bundesland_map, tolerance = 0.01)
  rm(germany_bundeslaender)
} else {
  germany_bundeslaender_n <- 0L
  bundesland_counts <- tibble::tibble()
  bundesland_map <- NULL
  bundesland_map_plot <- NULL
}

bundesland_join_check <- tibble::tibble(
  metric = c("Germany observations before join", "Matched to a federal state", "Federal states with observations"),
  value = c(format_number(nrow(germany)), format_number(germany_bundeslaender_n), format_number(nrow(bundesland_counts)))
)
nice_table(bundesland_join_check, "Federal state spatial join check")
```

```{r}
#| label: fig-de-bundesland-bar
#| fig-cap: "Germany observations by federal state"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 4.5
if (nrow(bundesland_counts) == 0) {
  empty_plot("Federal state counts are unavailable because the boundary file was not loaded.")
} else {
  ggplot(bundesland_counts, aes(x = reorder(bundesland, observations), y = observations)) +
    geom_col(fill = "steelblue") +
    geom_text(aes(label = format_number(observations)), hjust = -0.05, size = 3) +
    coord_flip() +
    scale_y_continuous(labels = scales::comma_format(), expand = expansion(mult = c(0, 0.15))) +
    plot_labs(x = NULL, y = "Observations") +
    theme_gtree()
}
```

```{r}
#| label: fig-de-bundesland-map
#| fig-cap: "Observation frequency by federal state"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 5
if (is.null(bundesland_map)) {
  empty_plot("Federal state map is unavailable because the boundary file was not loaded.")
} else {
  ggplot(bundesland_map_plot) +
    geom_sf(aes(fill = observations), color = "white", linewidth = 0.35) +
    scale_fill_viridis_c(option = "C", trans = "sqrt", labels = scales::comma_format(),
                         breaks = scales::breaks_pretty(n = 5),
                         guide = guide_colorbar(
                           barwidth = 12, barheight = 0.6,
                           label.theme = element_text(angle = 45, hjust = 1, size = 9)
                         )) +
    plot_labs(
      subtitle = NULL,
      fill = "Observations",
      caption = "Boundaries: GISCO NUTS1 regions. Counts: GlobalGeoTree Germany subset."
    ) +
    theme_map_gtree()
}
```

@fig-de-bundesland-bar provides exact rankings, while @fig-de-bundesland-map shows whether high-record states cluster in one part of Germany.

Observations are concentrated in western and southern Germany. Nordrhein-Westfalen has the highest count, with Bayern, Baden-Württemberg and Niedersachsen also recording many observations. Eastern states and Saarland generally have fewer records, showing that sampling effort is uneven across Germany.

That ranking is worth a second look, because it closely follows the states' populations rather than anything about trees: Nordrhein-Westfalen, Bayern, Baden-Württemberg and Niedersachsen are also Germany's four most populous states, in almost that order. The counts here are raw totals, not normalised by area or population, so the chart cannot separate "more trees" from "more people who record trees" — and the population ordering suggests the second reading is the stronger one. Confirming this would need observations per capita or per square kilometre, which this report does not compute; it is noted here as a limitation on how @fig-de-bundesland-bar should be read.

# Berlin

Berlin is the city of our university, which is why it was selected as the main target for regional analysis in Germany. As a city-state, Berlin's entire area is urban, which may produce recording patterns quite different from larger, more rural federal states. Whether that expectation holds is tested below — it does not.

## Pre-Processing

Berlin is handled separately because a finer boundary layer than the federal states is needed for city-level analysis. The boundaries come from an open-data project and provide polygons for Berlin's **local areas (Ortsteile)** — the small sub-units nested inside Berlin's twelve boroughs (Bezirke). "Local area" always refers to an Ortsteil in this part of the report; the polygon count is reported in the boundary check below.

```{r load-berlin-boundaries}
#| cache: true
berlin_result <- read_geojson_local_or_url(berlin_local_path, berlin_district_url, "Berlin local-area")
berlin_districts <- berlin_result$data

if (!is.null(berlin_districts)) {
  name_col <- intersect(c("name", "bezirk", "district", "gemeinde_name", "gen", "ortsteil"), names(berlin_districts))[1]
  if (is.na(name_col)) {
    berlin_districts$district <- paste("Area", seq_len(nrow(berlin_districts)))
  } else {
    berlin_districts$district <- as.character(berlin_districts[[name_col]])
  }
  berlin_districts <- berlin_districts |>
    select(district, geometry) |>
    filter(!is.na(district), district != "")
}

has_berlin_districts <- !is.null(berlin_districts) && nrow(berlin_districts) > 0
berlin_districts_plot <- simplify_for_plot(berlin_districts, tolerance = 0.0005)

berlin_boundary_status <- tibble::tibble(
  item = c("Berlin boundary status", "Number of Berlin polygons"),
  value = c(berlin_result$note, ifelse(has_berlin_districts, format_number(nrow(berlin_districts)), "0"))
)
nice_table(berlin_boundary_status, "Berlin boundary check")
```

## Berlin observations

```{r berlin-filter-and-summary}
#| cache: true
if (has_berlin_districts) {
  district_bbox <- sf::st_bbox(berlin_districts)
  germany_points_near_berlin <- germany_points |>
    filter(longitude >= district_bbox[["xmin"]], longitude <= district_bbox[["xmax"]],
           latitude >= district_bbox[["ymin"]], latitude <= district_bbox[["ymax"]])
  berlin_joined <- sf::st_join(germany_points_near_berlin, berlin_districts, left = FALSE, join = sf::st_within)
  berlin <- berlin_joined |> sf::st_drop_geometry() |> tibble::as_tibble()
  berlin_filter_method <- "Spatial join to Berlin district/local-area polygons"
  rm(berlin_joined, germany_points_near_berlin)
} else {
  berlin <- germany |>
    filter(longitude >= berlin_bbox$lon_min, longitude <= berlin_bbox$lon_max,
           latitude >= berlin_bbox$lat_min, latitude <= berlin_bbox$lat_max) |>
    mutate(district = NA_character_)
  berlin_filter_method <- "Approximate Berlin bounding box fallback"
}

berlin_summary <- make_state_summary(berlin, "Berlin", berlin_filter_method)
nice_table(berlin_summary, "Berlin observation summary")
```

## Berlin observation sources

-   *Which data sources contribute to Berlin's observations, and does one platform dominate?*

```{r berlin-source-summary}
berlin_source_counts <- make_source_counts(berlin)
# Counts feed the bar chart below; the table view was removed as it duplicated that chart.
```

```{r}
#| label: fig-berlin-source
#| fig-cap: "Berlin observations by source"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 3.5
ggplot(berlin_source_counts, aes(x = source_short, y = observations)) +
  geom_col(fill = "steelblue") +
  geom_text(aes(label = label), hjust = -0.05, size = 3) +
  coord_flip() +
  scale_y_continuous(labels = scales::comma_format(), expand = expansion(mult = c(0, 0.18))) +
  plot_labs(x = NULL, y = "Observations") +
  theme_gtree()
```

As @fig-berlin-source shows, Berlin's records are strongly dominated by iNaturalist research-grade, which contributes `r format_percent(berlin_source_counts$share[1])` of observations. Pl\@ntNet auto ID adds another `r format_percent(berlin_source_counts$share[2])`, while ArtenFinder contributes `r format_percent(berlin_source_counts$share[3])`. Together, these three sources provide `r format_percent(sum(berlin_source_counts$share[1:3]))` of the Berlin dataset.

The majority of Berlin observations come from citizen-science platforms — both global ones, such as iNaturalist and Pl\@ntNet, and local ones, such as ArtenFinder and naturgucker.

The source mix has now flipped twice. iNaturalist leads globally (Part I), Pl\@ntNet auto ID leads nationally in Germany (@fig-de-source-bar), and Berlin reverts to iNaturalist research-grade at `r format_percent(berlin_source_counts$share[1])`. Berlin is not representative of Germany in the way that Germany is not representative of the world. Each nested scale is dominated by a different platform, so the composition of any GlobalGeoTree subset has to be checked at the scale being analysed rather than inherited from the level above.

## Spatial distribution of Berlin observations

-   *Which parts of Berlin show the highest recording density?*

```{r}
#| label: fig-berlin-density
#| fig-cap: "Tree observation density in Berlin"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 5
berlin_points_for_map <- sample_up_to(berlin, max_berlin_points)

if (nrow(berlin_points_for_map) < 3) {
  empty_plot("Not enough Berlin observations were available for a density map.")
} else if (has_berlin_districts) {
  ggplot() +
    stat_density_2d_filled(data = berlin_points_for_map,
                           aes(x = longitude, y = latitude, fill = after_stat(level)),
                           contour_var = "ndensity", bins = 8, alpha = 0.78) +
    geom_sf(data = berlin_districts_plot, fill = NA, color = "gray25", linewidth = 0.35) +
    geom_point(data = berlin_points_for_map, aes(x = longitude, y = latitude), alpha = 0.14, size = 0.35) +
    coord_sf() +
    scale_fill_viridis_d(option = "C", direction = -1, name = "Density") +
    plot_labs(caption = paste("Density and points use", format_number(nrow(berlin_points_for_map)), "sampled Berlin observations."),
         x = NULL, y = NULL) +
    theme_map_gtree()
} else {
  ggplot(berlin_points_for_map, aes(x = longitude, y = latitude)) +
    stat_density_2d_filled(contour_var = "ndensity", bins = 8, alpha = 0.8) +
    geom_point(alpha = 0.12, size = 0.35) +
    coord_fixed() +
    scale_fill_viridis_d(option = "C", direction = -1, name = "Density") +
    plot_labs(subtitle = "Local-area borders were unavailable, so this map uses the Berlin bounding-box fallback.",
         caption = paste("Density and points use", format_number(nrow(berlin_points_for_map)), "sampled Berlin observations."),
         x = "Longitude", y = "Latitude") +
    theme_gtree()
}
```

@fig-berlin-density highlights which parts of Berlin have the most recorded tree observations. As always in this part, high-density areas correspond to parks, green corridors, and neighbourhoods with active observers rather than to places that necessarily hold more trees.

Observations are strongly concentrated in western Berlin, with the clearest hotspot just west of the city centre, in Grunewald. Smaller clusters appear in the southwest and along the southern edge, while most central and eastern local areas have much lower recording density.

## Berlin local areas: observations and species

-   *Do the local areas with the most observations also have the most recorded species?*

```{r berlin-district-summary}
if ("district" %in% names(berlin) && any(!is.na(berlin$district))) {
  berlin_district_counts <- berlin |>
    filter(!is.na(district), district != "") |>
    group_by(district) |>
    summarise(observations = n(), species = n_distinct(level3_species),
              sources = n_distinct(source_raw), .groups = "drop") |>
    arrange(desc(observations))
} else {
  berlin_district_counts <- tibble::tibble()
}

# Counts feed the bar charts and choropleth below; the table view was removed as redundant.
```

```{r}
#| label: fig-berlin-area-bar
#| fig-cap: "Berlin observations by local area"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 4.5
if (nrow(berlin_district_counts) == 0) {
  empty_plot("Berlin local-area counts are unavailable because polygons were not loaded.")
} else {
  berlin_district_counts |>
    slice_head(n = 20) |>
    ggplot(aes(x = reorder(district, observations), y = observations)) +
    geom_col(fill = "steelblue") +
    geom_text(aes(label = format_number(observations)), hjust = -0.05, size = 3) +
    coord_flip() +
    scale_y_continuous(labels = scales::comma_format(), expand = expansion(mult = c(0, 0.15))) +
    plot_labs(subtitle = "Only the top 20 areas are shown.", x = NULL, y = "Observations") +
    theme_gtree()
}
```

Grunewald dominates the dataset with `r format_number(berlin_district_counts$observations[1])` observations — `r round(berlin_district_counts$observations[1] / berlin_district_counts$observations[2], 1)` times the count for Wannsee, the next local area. Third-placed `r berlin_district_counts$district[3]` has only `r format_number(berlin_district_counts$observations[3])`, and every area below it fewer still, so recording is heavily concentrated in the southwest.

This is where the expectation set out at the start of this section breaks down. Berlin was chosen partly because, as a city-state, its entire area is urban — but the places driving its record count are not urban in any ordinary sense. Grunewald is Berlin's largest forest; Wannsee and Dahlem, the next-ranked areas, are green, peripheral and affluent. The dense central boroughs, where street trees actually are, contribute little. Berlin's tree records therefore describe woodland and leafy periphery visited by recreational observers, not the urban tree stock of a capital city. The city-state framing turns out to predict the opposite of what the data shows.

```{r}
#| label: fig-berlin-area-species
#| fig-cap: "Recorded species by Berlin local area"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 4.5
if (nrow(berlin_district_counts) == 0) {
  empty_plot("Berlin local-area species counts are unavailable because polygons were not loaded.")
} else {
  berlin_district_counts |>
    arrange(desc(species)) |>
    slice_head(n = 20) |>
    ggplot(aes(x = reorder(district, species), y = species)) +
    geom_col(fill = "steelblue") +
    geom_text(aes(label = format_number(species)), hjust = -0.05, size = 3) +
    coord_flip() +
    plot_labs(x = NULL, y = "Recorded species") +
    scale_y_continuous(labels = scales::comma_format(), expand = expansion(mult = c(0, 0.15))) +
    theme_gtree()
}
```

Grunewald and Wannsee also have the highest recorded species counts. Buch stands out with `r format_number(berlin_district_counts$species[berlin_district_counts$district == "Buch"])` species despite having fewer observations than Dahlem, suggesting that observation volume and recorded richness do not always rise together.

The gap between @fig-berlin-area-bar and @fig-berlin-area-species is itself informative. Grunewald's lead in species is nowhere near as extreme as its lead in observations, which is what one would expect from saturation: once an area has been visited often enough, additional visits mostly re-record species already on the list. Recorded richness is bounded by the local flora, whereas observation counts are bounded only by observer enthusiasm. Comparing richness across areas with such unequal effort would need rarefaction of the kind applied to continents in Part I and to U.S. regions in Part III; without it, @fig-berlin-area-species should be read as "species found so far", not as a diversity ranking.

```{r}
#| label: fig-berlin-area-map
#| fig-cap: "Observation frequency by Berlin local area"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 5
if (has_berlin_districts && nrow(berlin_district_counts) > 0) {
  berlin_district_map <- berlin_districts |>
    left_join(berlin_district_counts, by = "district") |>
    mutate(observations = dplyr::coalesce(observations, 0L))
  berlin_district_map_plot <- simplify_for_plot(berlin_district_map, tolerance = 0.0005)
  ggplot(berlin_district_map_plot) +
    geom_sf(aes(fill = observations), color = "white", linewidth = 0.25) +
    scale_fill_viridis_c(
      option = "C", trans = "sqrt", labels = scales::comma_format(),
      guide = guide_colorbar(
        barwidth = 12, barheight = 0.6,
        label.theme = element_text(angle = 45, hjust = 1, size = 9)
      )
    ) +
    plot_labs(subtitle = NULL, fill = "Observations") +
    theme_map_gtree()
} else {
  empty_plot("Berlin local-area map is unavailable because polygons were not loaded.")
}
```

@fig-berlin-area-map shows the same counts in their spatial arrangement. Square-root scaling keeps both high- and medium-count local areas visible.

The map confirms a strong hotspot around Grunewald in western Berlin. Most central areas have low counts, while several outer areas in the southwest, north and southeast show moderate recording activity.

## Top recorded species in Berlin

-   *Which tree species are recorded most often in Berlin, and are the species labels trustworthy?*

```{r berlin-top-species}
berlin_named <- add_species_display_name(berlin)

berlin_top_species <- berlin_named |>
  count(level3_species, species_display_name, display_common_name_en, sort = TRUE, name = "observations") |>
  mutate(share = observations / sum(observations))

# The top-species table was removed; the bar chart below shows the same ranking.
```

```{r}
#| label: fig-berlin-top-species
#| fig-cap: "Most recorded tree species in Berlin"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 4.5
berlin_top_species |>
  slice_head(n = 15) |>
  ggplot(aes(x = reorder(species_display_name, observations), y = observations)) +
  geom_col(fill = "steelblue") +
  geom_text(aes(label = format_number(observations)), hjust = -0.05, size = 3) +
  coord_flip() +
  scale_y_continuous(labels = scales::comma_format(), expand = expansion(mult = c(0, 0.15))) +
  plot_labs(subtitle = "Common names shown where available.",
       x = NULL, y = "Observations") +
  theme_gtree()
```

@fig-berlin-top-species should be read with considerable caution, because it is the one figure in this part where the *labels* — not just the counts — are demonstrably wrong.

*Cupania sylvatica* tops the ranking, with roughly `r round(berlin_top_species$observations[1] / berlin_top_species$observations[2], 1)` times the observations of the next species. That result is not credible: *Cupania* is a Neotropical genus that does not grow wild in Brandenburg. The explanation is visible on the chart itself. The common names come from GBIF via `add_species_display_name()`, and the label rendered for this taxon is **"Litchi family"** — a *family* vernacular, not a species name. Its `species_key` (6657) is a family-rank GBIF identifier for Sapindaceae, not a species key.

The same fault recurs. `Croton laccifer` resolves to "Euphorbia family", `Schefflera macrophylla` to "Aralia and Ivy family", `Dombeya acerifolia` to "Mallow Family", `Salix arbutifolia` to "Willow Family". In every case a four-digit family-rank key sits where a seven-digit species key should be. The pattern suggests that where GlobalGeoTree could resolve a record only to family, it back-filled `level3_species` with an arbitrary — usually tropical — member of that family instead of leaving it blank. Read that way, the entries are not exotic at all: the Sapindaceae records are almost certainly maples, the Araliaceae records ivy, and the Malvaceae records limes — all thoroughly unremarkable Berlin trees wearing the wrong names. Across Germany these family-rank rows account for `r format_percent(sum(as.integer(species_names_raw$de_observations[nchar(as.character(species_names_raw$species_key)) <= 6])) / sum(as.integer(species_names_raw$de_observations)))` of observations.

A second, unrelated problem sits alongside it: *Dryocopus martius*, the black woodpecker, is the second most recorded taxon among the German species carrying a GBIF key, with `r format_number(as.integer(species_names_raw$de_observations[species_names_raw$level3_species == "Dryocopus martius"]))` records — behind only beech. It is a bird. Whatever filter was meant to restrict GlobalGeoTree to trees has let at least one animal through at high volume.

Both faults are inherited from the upstream dataset rather than introduced here, and neither is repaired in this report. The consequence is that this ranking cannot be read as a description of Berlin's tree stock: it is a description of Berlin's *labels*, and some of them are wrong. Species-level use of the German subset would need the taxonomy validated against GBIF ranks first. The spatial and source-level findings elsewhere in Part II do not depend on species identity and are unaffected.

## Berlin oak tree groups

-   *Where are recorded oak trees concentrated in Berlin, and how could these records support a follow-up analysis?*

This section demonstrates a possible practical application of the dataset. The oak processionary moth (*Thaumetopoea processionea*) can cause allergic reactions and skin irritation near affected oak trees. Mapping recorded oak locations provides a starting point that could be compared with official tree inventories and pest-surveillance data; GlobalGeoTree observations alone do not show whether the moth is present or whether a public warning is needed.

```{r berlin-oak-summary}
berlin_oaks <- berlin |>
  filter(
    stringr::str_to_lower(as.character(level2_genus)) == "quercus" |
      stringr::str_detect(stringr::str_to_lower(as.character(level3_species)), "^quercus\\b")
  )

berlin_oak_summary <- tibble::tibble(
  metric = c("Berlin oak observations", "Berlin recorded oak species", "Share of Berlin observations that are oak"),
  value = c(
    format_number(nrow(berlin_oaks)),
    format_number(n_distinct(berlin_oaks$level3_species)),
    ifelse(nrow(berlin) > 0, format_percent(nrow(berlin_oaks) / nrow(berlin)), "0%")
  )
)
nice_table(berlin_oak_summary, "Berlin oak observation summary")
```

```{r berlin-oak-local-areas}
if ("district" %in% names(berlin_oaks) && any(!is.na(berlin_oaks$district))) {
  berlin_oak_area_counts <- berlin_oaks |>
    filter(!is.na(district), district != "") |>
    count(district, name = "oak_observations", sort = TRUE)
} else {
  berlin_oak_area_counts <- tibble::tibble()
}

# Counts feed the oak map and the bar chart below; the table view was removed as redundant.
```

```{r}
#| label: fig-berlin-oak-map
#| fig-cap: "Recorded oak tree groups in Berlin"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 5
berlin_oak_points_for_map <- sample_up_to(berlin_oaks, max_berlin_points)

if (nrow(berlin_oak_points_for_map) == 0) {
  empty_plot("No Berlin oak observations were available for the oak map.")
} else if (has_berlin_districts) {
  p <- ggplot() +
    geom_sf(data = berlin_districts_plot, fill = "gray98", color = "gray75", linewidth = 0.25)
  if (nrow(berlin_oak_points_for_map) >= 3) {
    p <- p +
      stat_density_2d_filled(data = berlin_oak_points_for_map,
                             aes(x = longitude, y = latitude, fill = after_stat(level)),
                             contour_var = "ndensity", bins = 7, alpha = 0.72)
  }
  p +
    geom_point(data = berlin_oak_points_for_map, aes(x = longitude, y = latitude),
               color = "#4d2c0b", alpha = 0.45, size = 0.75) +
    geom_sf(data = berlin_districts_plot, fill = NA, color = "gray25", linewidth = 0.35) +
    coord_sf() +
    scale_fill_viridis_d(option = "B", direction = -1, name = "Oak density") +
    plot_labs(caption = paste("Displayed oak points:", format_number(nrow(berlin_oak_points_for_map)), "of", format_number(nrow(berlin_oaks)), "Berlin oak observations."),
         x = NULL, y = NULL) +
    theme_map_gtree()
} else {
  ggplot(berlin_oak_points_for_map, aes(x = longitude, y = latitude)) +
    geom_point(color = "#4d2c0b", alpha = 0.45, size = 0.75) +
    coord_fixed() +
    plot_labs(subtitle = "Local-area borders were unavailable, so this map uses the Berlin bounding-box fallback.",
         x = "Longitude", y = "Latitude") +
    theme_gtree()
}
```

The oak pattern in @fig-berlin-oak-map closely follows the overall pattern in @fig-berlin-density, with the strongest concentration in the west. The oak map therefore mainly reflects where recording is most intensive, not where oaks are most common.

```{r}
#| label: fig-berlin-oak-bar
#| fig-cap: "Recorded oak observations by Berlin local area"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 4.5
if (nrow(berlin_oak_area_counts) == 0) {
  empty_plot("Berlin oak local-area counts are unavailable.")
} else {
  berlin_oak_area_counts |>
    slice_head(n = 20) |>
    ggplot(aes(x = reorder(district, oak_observations), y = oak_observations)) +
    geom_col(fill = "steelblue") +
    geom_text(aes(label = format_number(oak_observations)), hjust = -0.05, size = 3) +
    coord_flip() +
    scale_y_continuous(labels = scales::comma_format(), expand = expansion(mult = c(0, 0.15))) +
    plot_labs(x = NULL, y = "Oak observations") +
    theme_gtree()
}
```

Grunewald, Dahlem and other highly sampled areas also contain most oak records. Because the full dataset is spatially biased, the oak subset inherits the same bias, so these counts should not be read as a ranking of true oak abundance.

It is worth stating plainly what this means for the application proposed above, because the answer is negative. A processionary-moth warning system needs to know where oaks *are*; @fig-berlin-oak-bar shows where oaks were *looked at*. An area with many oaks and no observers is indistinguishable here from an area with no oaks, and those are exactly the areas a public-health warning would most need to reach. GlobalGeoTree cannot supply this on its own — the oak records are usable as a supplementary layer over an official tree inventory, which has known coverage, but not as a substitute for one. The value of this section is in showing what the dataset would need to be joined against, rather than in the map itself.

# Baden-Württemberg and Nordrhein-Westfalen

-   *Is Berlin's spatial concentration of observations a Berlin-specific pattern, or is it typical for German regions?*

The Berlin analysis above revealed that observations are heavily concentrated in a single location. To investigate, we compare Berlin with Nordrhein-Westfalen (NRW) and Baden-Württemberg — the first and third largest federal states by observation count. For each state, a density map and a NUTS3 district choropleth show where observations are concentrated.

One caveat applies to the whole comparison. Berlin covers about 890 km² and is divided into small local areas; Baden-Württemberg and NRW each cover roughly 35,000 km² and are divided into much larger NUTS3 districts. Measured concentration depends on the size of the units doing the measuring, so "Berlin is more concentrated" cannot be read straight off the maps — the comparison below rests on the *shape* of the density surfaces, which are computed from coordinates rather than administrative units, and treats the choropleths as supporting detail only.

```{r load-bw-boundaries}
#| include: false
#| cache: true
bw_boundary <- get_bundesland_boundary(bundeslaender, "baden|württemberg|wuerttemberg|wurttemberg")
bw_districts <- prepare_nuts3_districts(nuts3, nuts_prefix = "DE1", fallback_label = "Baden-Württemberg district")

has_bw_boundary <- !is.null(bw_boundary) && nrow(bw_boundary) > 0
has_bw_districts <- !is.null(bw_districts) && nrow(bw_districts) > 0
bw_boundary_plot <- simplify_for_plot(bw_boundary, tolerance = 0.003)
```

```{r filter-bw}
#| include: false
#| cache: true
bw_filtered <- filter_state_observations(
  points_sf = germany_points, fallback_data = germany,
  boundary_data = bw_boundary, fallback_bbox = bw_bbox,
  boundary_note = "Spatial join to official NUTS1 Baden-Württemberg boundary",
  fallback_note = "Approximate Baden-Württemberg bounding box fallback"
)
bw <- bw_filtered$data
rm(bw_filtered)
```

## Baden-Württemberg

```{r}
#| label: fig-bw-density
#| fig-cap: "Baden-Württemberg observation density"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 5
bw_points_for_map <- sample_up_to(bw, max_bw_points)
bw_boundary_for_map <- if (has_bw_boundary) bw_boundary_plot else NULL

if (nrow(bw_points_for_map) < 3) {
  empty_plot("Not enough Baden-Württemberg observations were available for the density map.")
} else {
  plot_filled_density_map(
    points_data = bw_points_for_map, boundary_data = bw_boundary_for_map,
    title = NULL,
    subtitle = NULL,
    caption = "This shows recording density in the dataset, not true tree abundance.",
    bins = 9, alpha = 0.90
  )
}
```

In Baden-Württemberg recording is stronger in the west and south than in many eastern areas. Several hotspots are visible, especially in the southwest, northwest and central part of the state. Unlike Berlin, where observations are concentrated mainly around one western hotspot, Baden-Württemberg has several separate centres of recording activity.

### Baden-Württemberg observations by NUTS3 district

```{r bw-district-join}
#| include: false
#| cache: true
bw_district_outputs <- make_district_outputs(bw, bw_districts)
bw_district_counts <- bw_district_outputs$counts
bw_district_map <- bw_district_outputs$map
bw_district_map_plot <- simplify_for_plot(bw_district_map, tolerance = 0.003)
rm(bw_district_outputs)
```

```{r}
#| label: fig-bw-district-map
#| fig-cap: "Baden-Württemberg observation frequency by NUTS3 district"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 5
if (is.null(bw_district_map)) {
  empty_plot("Baden-Württemberg district map is unavailable because NUTS3 polygons were not loaded.")
} else {
  ggplot(bw_district_map_plot) +
    geom_sf(aes(fill = observations), color = "white", linewidth = 0.15) +
    scale_fill_viridis_c(
      option = "C", trans = "sqrt", labels = scales::comma_format(),
      guide = guide_colorbar(
        barwidth = 12, barheight = 0.6,
        label.theme = element_text(angle = 45, hjust = 1, size = 9)
      )
    ) +
    plot_labs(subtitle = NULL, fill = "Observations") +
    theme_map_gtree()
}
```

Square-root scaling is applied so that a few very high-count districts do not wash out variation among the rest.

@fig-bw-district-map confirms that observations are unevenly distributed. The highest counts occur in the far southwest, while several western, northern and southern districts also have relatively high totals. Many central and eastern districts contribute fewer records.

## Nordrhein-Westfalen

NRW serves the same role as Baden-Württemberg: a state-level comparison point for Berlin.

```{r load-nrw-boundaries}
#| include: false
#| cache: true
nrw_boundary <- get_bundesland_boundary(bundeslaender, "nordrhein|north rhine|westfalen|westphalia")
nrw_districts <- prepare_nuts3_districts(nuts3, nuts_prefix = "DEA", fallback_label = "NRW district")

has_nrw_boundary <- !is.null(nrw_boundary) && nrow(nrw_boundary) > 0
has_nrw_districts <- !is.null(nrw_districts) && nrow(nrw_districts) > 0
nrw_boundary_plot <- simplify_for_plot(nrw_boundary, tolerance = 0.003)
```

```{r filter-nrw}
#| include: false
#| cache: true
nrw_filtered <- filter_state_observations(
  points_sf = germany_points, fallback_data = germany,
  boundary_data = nrw_boundary, fallback_bbox = nrw_bbox,
  boundary_note = "Spatial join to official NUTS1 NRW boundary",
  fallback_note = "Approximate NRW bounding box fallback"
)
nrw <- nrw_filtered$data
rm(nrw_filtered)
```

```{r}
#| label: fig-nrw-density
#| fig-cap: "NRW observation density"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 5
nrw_points_for_map <- sample_up_to(nrw, max_nrw_points)
nrw_boundary_for_map <- if (has_nrw_boundary) nrw_boundary_plot else NULL

if (nrow(nrw_points_for_map) < 3) {
  empty_plot("Not enough NRW observations were available for the density maps.")
} else {
  plot_filled_density_map(
    points_data = nrw_points_for_map, boundary_data = nrw_boundary_for_map,
    title = NULL,
    subtitle = NULL,
    caption = "This shows recording density in the dataset, not true tree abundance.",
    bins = 9, alpha = 0.90
  )
}
```

NRW has several observation hotspots rather than one dominant centre. High recording density appears in the southwest, central-west and north, with smaller clusters in the east. This is more dispersed than Berlin's strongly concentrated western hotspot and helps explain the broad area of high density seen in western Germany in @fig-de-density.

### NRW observations by NUTS3 district

```{r nrw-district-join}
#| include: false
#| cache: true
nrw_district_outputs <- make_district_outputs(nrw, nrw_districts)
nrw_district_counts <- nrw_district_outputs$counts
nrw_district_map <- nrw_district_outputs$map
nrw_district_map_plot <- simplify_for_plot(nrw_district_map, tolerance = 0.003)
rm(nrw_district_outputs)
```

```{r}
#| label: fig-nrw-district-map
#| fig-cap: "NRW observation frequency by NUTS3 district"
#| fig-cap-location: bottom
#| fig-width: 6
#| fig-height: 5
if (is.null(nrw_district_map)) {
  empty_plot("NRW district map is unavailable because NUTS3 polygons were not loaded.")
} else {
  ggplot(nrw_district_map_plot) +
    geom_sf(aes(fill = observations), color = "white", linewidth = 0.15) +
    scale_fill_viridis_c(
      option = "C", trans = "sqrt", labels = scales::comma_format(),
      guide = guide_colorbar(
        barwidth = 12, barheight = 0.6,
        label.theme = element_text(angle = 45, hjust = 1, size = 9)
      )
    ) +
    plot_labs(subtitle = NULL, fill = "Observations") +
    theme_map_gtree()
}
```

As above, square-root scaling is used so that dominant districts do not obscure the rest of the distribution.

@fig-nrw-district-map confirms that records are uneven but spread across much of NRW. A few northern and southern districts have the highest totals, while many central districts show medium counts. Compared with Baden-Württemberg, NRW has a similarly multi-centred pattern; compared with Berlin, its observations are less dependent on one local area.

Comparing @fig-bw-density and @fig-nrw-density with @fig-berlin-density answers the question this section opened with. Observations in Baden-Württemberg and NRW are spread much more evenly across their territories, with multiple distinct hotspots corresponding to major cities and populated areas, whereas Berlin's observations are heavily concentrated in a single location. Berlin's concentration is therefore Berlin-specific rather than typical of German regions, and the Berlin subset is better described as localised recording activity than as a representative spatial sample of the city's tree cover.

The scale caveat above limits how far this can be pushed: the density surfaces are directly comparable in shape, but Berlin is two orders of magnitude smaller in area, and a single forest occupies a far larger fraction of it than any one wood could occupy in a large state. Some concentration is expected simply from the geography. What the comparison supports is that Berlin's pattern is different in kind — one site rather than several centres — and not merely different in degree.

# Germany: Conclusions

Part II asked where tree observations in Germany come from, who records them, and whether the national picture holds at city scale. Five findings stand out.

**Recording is a western and southwestern phenomenon, and it tracks people.** @fig-de-density and @fig-de-points agree: intensity is highest in the west and south, with an isolated hotspot at Berlin and thin coverage across the east and northeast. At state level, Nordrhein-Westfalen leads, followed by Bayern, Baden-Württemberg and Niedersachsen — which is close to Germany's population ranking. Because the counts are raw rather than normalised, the federal state comparison cannot separate tree cover from observer density, and the population ordering suggests observers are doing most of the work.

**No single platform describes Germany, and the mix changes with scale.** Pl\@ntNet auto ID contributes `r format_percent(de_source_counts$share[1])` of German records and the three largest sources `r format_percent(sum(de_source_counts$share[1:3]))`, so national patterns are effectively the patterns of three platforms. That composition is not the global one — iNaturalist leads worldwide with `r format_percent(inat_share)` — and it is not Berlin's either, where iNaturalist returns to the front with `r format_percent(berlin_source_counts$share[1])`. Global, national and city scales are each dominated by a different source, so source composition has to be established at the scale being analysed and never inherited from the level above.

**Berlin's tree records describe a forest, not a city.** Grunewald alone holds `r format_number(berlin_district_counts$observations[1])` observations, `r round(berlin_district_counts$observations[1] / berlin_district_counts$observations[2], 1)` times the next local area, with the dense central boroughs contributing little. The expectation that a city-state would yield urban, street-tree recording is contradicted by its own data: what the Berlin subset captures is recreational recording in woodland and leafy periphery. The oak analysis inherits this bias exactly, which is why it cannot underpin a processionary-moth warning system without an official inventory to supply the coverage GlobalGeoTree lacks.

**That concentration is specific to Berlin.** Baden-Württemberg and NRW are multi-centred, with hotspots at their major population centres rather than at one site (@fig-bw-density, @fig-nrw-density). Berlin differs in kind, not just degree — though the comparison spans very different areal units and should be read from the density surfaces rather than the choropleths.

**Species-level labels in the German subset are not trustworthy.** Around `r format_percent(sum(as.integer(species_names_raw$de_observations[nchar(as.character(species_names_raw$species_key)) <= 6])) / sum(as.integer(species_names_raw$de_observations)))` of German observations carry family-rank GBIF keys behind plausible-looking species names, so the "tropical" trees topping the Berlin ranking are almost certainly maples, ivy and limes; a black woodpecker ranks second nationally. These faults come from the upstream dataset and are not repaired here. The spatial and source-level conclusions above do not depend on species identity, but any species-level use of this subset would need the taxonomy validated first.

Taken together, Part II measures **recording behaviour in Germany, not German tree cover**. Every pattern above — the western skew, the state ranking, the Berlin hotspot, the oak distribution — is better explained by where observers go and which app they use than by where trees grow. This does not make the data useless, but it fixes what it can answer: it is evidence about a sampling process, and only indirectly about the thing sampled.

# Part III: Distribution of the data in the United States {.unnumbered}

::: {.callout-note appearance="minimal"}
*— Santiago*
:::

This part focuses on the U.S. records and asks whether their distribution reflects ecological patterns, the way the data was collected, or a combination of both. Knowing which places and years contribute most of the observations is necessary before drawing conclusions about tree diversity from the dataset.

The analysis first describes national coverage and its regional imbalance. It then compares foliage categories, latitude profiles, and taxonomic richness. The final figures add the time dimension to show whether the geographical pattern changed as the number of records increased.

## Pre-Processing

Rows labelled with the `US` country code were retained. Their coordinates were matched to state polygons from the `maps` package; points missed by the simplified coastal boundaries were linked to the closest state centre. The state names were then converted into the four Census regions—Northeast, South, Midwest, and West—so that comparisons would not be fragmented across fifty individual states.

```{r us-repartition-setup}
#| include: false
#| cache: true

us_df <- data.table::as.data.table(data)
us_df <- us_df[country_code == "US" & is.finite(longitude) & is.finite(latitude), ]

# Assign observations to states. Points that fall just outside the simplified
# map polygons (mainly coastlines) are assigned to their nearest state centre.
state_raw <- maps::map.where("state", us_df$longitude, us_df$latitude)
state_raw <- sub(":.*", "", state_raw)
state_lookup <- setNames(as.character(state.region), tolower(state.name))
us_df$state <- state_raw

missing_state <- which(is.na(us_df$state) | !us_df$state %in% names(state_lookup))
if (length(missing_state) > 0) {
  best_distance <- rep(Inf, length(missing_state))
  best_state <- integer(length(missing_state))
  for (j in seq_along(state.name)) {
    dx <- (state.center$x[j] - us_df$longitude[missing_state]) *
      cos(us_df$latitude[missing_state] * pi / 180)
    dy <- state.center$y[j] - us_df$latitude[missing_state]
    distance <- dx^2 + dy^2
    closer <- distance < best_distance
    best_distance[closer] <- distance[closer]
    best_state[closer] <- j
  }
  us_df$state[missing_state] <- tolower(state.name[best_state])
}

us_df$region <- unname(state_lookup[us_df$state])
us_df$region[us_df$region == "North Central"] <- "Midwest"
us_df$region <- factor(us_df$region,
  levels = c("Northeast", "South", "Midwest", "West"))

region_colors <- c(
  "Northeast" = "#0072B2",
  "South" = "#E69F00",
  "Midwest" = "#009E73",
  "West" = "#CC79A7"
)

foliage_colors <- c(
  "Deciduous Broadleaf" = "#E69F00",
  "Evergreen Broadleaf" = "#009E73",
  "Evergreen Needleleaf" = "#0072B2",
  "Deciduous Needleleaf" = "#CC79A7"
)

pct <- function(x, digits = 1) paste0(format(round(100*x, digits), nsmall=digits), "%")

draw_conus <- function(fill = "grey92", border = "white") {
  maps::map("state", fill = TRUE, col = fill, border = border,
      xlim = c(-125, -66), ylim = c(24, 50), mar = c(0,0,0,0))
}
```

@tbl-us-dataset displays the working variables after this preparation.

```{r}
#| label: tbl-us-dataset
#| tbl-cap: "First observations after preparing the U.S. subset"
#| tbl-cap-location: bottom

knitr::kable(head(us_df[, c("sample_id", "level0", "level1_family", "level2_genus",
                         "level3_species", "year", "longitude", "latitude",
                         "state", "region"), with=FALSE]), row.names = FALSE)
```

The regional colors in @fig-us-colour-region remain unchanged from one graph to another. They come from the colorblind-friendly Okabe-Ito palette.

```{r}
#| label: fig-us-colour-region
#| fig-cap: "Regional colors used throughout the U.S. analysis"
#| fig-cap-location: bottom
#| fig-height: 2.5

par(mar = c(1,1,1,1))
plot.new(); plot.window(xlim=c(0,4), ylim=c(0,1))
for (i in seq_along(region_colors)) {
  rect(i-1, 0, i, 1, col=region_colors[i], border=NA)
  text(i-.5, .58, names(region_colors)[i], font=2, cex=.9)
  text(i-.5, .35, region_colors[i], cex=.75)
}
```

## United States overview

The initial overview separates national reach from sampling intensity. A dataset may include all major parts of the country and still be dominated by a few places.

For that reason, @fig-us-map-region shows the individual coordinates, @fig-us-bar-region compares the regional totals, and @fig-us-density-map identifies the cells where records accumulate most strongly.

```{r}
#| label: fig-us-map-region
#| fig-cap: "Location of U.S. observations, colored by Census region"
#| fig-cap-location: bottom
#| fig-height: 7

conus <- us_df[us_df$longitude >= -125 & us_df$longitude <= -66 &
            us_df$latitude >= 24 & us_df$latitude <= 50, ]
alaska <- us_df[us_df$state == "alaska", ]
hawaii <- us_df[us_df$state == "hawaii", ]

layout(matrix(c(1,1,1,1,2,3), nrow=2, byrow=TRUE), heights=c(3,1.25))
par(mar=c(3,3,2,1))
draw_conus()
points(conus$longitude, conus$latitude, pch=16, cex=.32,
       col=adjustcolor(region_colors[as.character(conus$region)], alpha.f=.35))
title("Contiguous United States", xlab="Longitude", ylab="Latitude")
par(mar=c(3,3,2,1))
maps::map("world", regions="USA", fill=TRUE, col="grey92", border="white",
    xlim=c(-170,-130), ylim=c(50,72))
points(alaska$longitude, alaska$latitude, pch=16, cex=.45,
       col=adjustcolor(region_colors["West"], alpha.f=.45)); title("Alaska")
maps::map("world", regions="USA", fill=TRUE, col="grey92", border="white",
    xlim=c(-161,-154), ylim=c(18,23))
points(hawaii$longitude, hawaii$latitude, pch=16, cex=.45,
       col=adjustcolor(region_colors["West"], alpha.f=.45)); title("Hawaii")
layout(1)
```

The points in @fig-us-map-region cover most of the country, but not with the same intensity. Texas, California, Florida, and the Northeast form visible clusters, whereas the Great Plains and much of the interior West are sparsely represented. Accessibility and the location of contributors probably explain part of this contrast, so the map cannot be read as a map of tree abundance.

```{r}
#| label: fig-us-bar-region
#| fig-cap: "Contribution of each U.S. region to the complete U.S. subset"
#| fig-cap-location: bottom
#| fig-height: 4.5

region_n <- sort(table(us_df$region), decreasing=TRUE)
par(mar=c(5,8,2,2))
bp <- barplot(rev(region_n), horiz=TRUE, las=1, border=NA,
              col=region_colors[names(rev(region_n))],
              xlim=c(0,max(region_n)*1.22), xlab="Number of observations")
text(rev(region_n), bp,
     labels=paste0(rev(region_n), "  (", pct(rev(region_n)/sum(region_n)), ")"),
     pos=4, cex=.85)
```

The regional counts in @fig-us-bar-region make the imbalance more explicit. The South supplies the largest share of records, followed by the West. The Northeast and Midwest have considerably fewer rows. These percentages refer to dataset participation and should not be interpreted as regional forest shares.

```{r}
#| label: fig-us-density-map
#| fig-cap: "Local concentration of records across the contiguous United States"
#| fig-cap-location: bottom
#| fig-height: 5.5

xb <- seq(-125,-65,by=1); yb <- seq(24,51,by=1)
h <- table(cut(conus$longitude,xb), cut(conus$latitude,yb))
image(xb[-length(xb)]+.5, yb[-length(yb)]+.5, log10(h+1),
      col=colorRampPalette(c("white","#B8E0D2","#4C956C","#173F35"))(40),
      xlab="Longitude", ylab="Latitude", useRaster=TRUE)
maps::map("state", add=TRUE, col="grey55", lwd=.45)
```

The grid representation in @fig-us-density-map isolates the main hotspots around central Texas, southern California, Florida, and the northeastern corridor. Pale inland cells indicate limited sampling rather than an absence of trees.

Overall, the U.S. subset has a wide footprint but an uneven internal balance. The following comparisons are therefore interpreted as patterns within the available records, not as a national census.

## Spatial distribution of foliage types

The next step is to compare the kinds of trees recorded in different places. Foliage categories summarize important ecological strategies: broad or needle-shaped leaves and evergreen or deciduous behavior respond differently to cold, drought, and seasonality.

The small maps in @fig-us-maps-foliage preserve the spatial detail. @fig-us-bar-foliage-region converts those records into regional percentages, while @fig-us-ridge-latitude removes the administrative boundaries and follows the north–south gradient directly.

```{r}
#| label: fig-us-maps-foliage
#| fig-cap: "U.S. locations recorded for each foliage category"
#| fig-cap-location: bottom
#| fig-height: 8

observed_types <- names(sort(table(conus$level0), decreasing=TRUE))
op <- par(mfrow=c(2,2), mar=c(2,2,2,.5), oma=c(2,2,0,0))
for (tp in observed_types) {
  z <- conus[conus$level0 == tp,]
  draw_conus()
  points(z$longitude,z$latitude,pch=16,cex=.3,
         col=adjustcolor(foliage_colors[tp],alpha.f=.4))
  title(tp, cex.main=.9)
}
if (length(observed_types)<4) plot.new()
mtext("Longitude",1,outer=TRUE); mtext("Latitude",2,outer=TRUE)
par(op)
```

The categories in @fig-us-maps-foliage do not occupy identical spaces. Deciduous Broadleaf is found throughout the contiguous states and is particularly visible in the East and South. Evergreen Broadleaf is concentrated farther south and on the Pacific coast, while Evergreen Needleleaf forms strong western and northern clusters. Deciduous Needleleaf is present in pink, but its 10,951 records make it much rarer than the other three categories.

```{r}
#| label: fig-us-bar-foliage-region
#| fig-cap: "Foliage composition within each U.S. region"
#| fig-cap-location: bottom
#| fig-height: 5.5


fol_region <- prop.table(
  table(us_df$level0, us_df$region),
  2
) * 100

fol_region <- fol_region[
  , colSums(fol_region) > 0,
  drop = FALSE
]

# Larger right margin for the legend
par(mar = c(7, 5, 2, 14), xpd = TRUE)

barplot(
  fol_region,
  col = foliage_colors[rownames(fol_region)],
  border = NA,
  las = 2,
  ylab = "Proportion of observations (%)"
)

legend(
  "topright",
  inset = c(-0.48, 0),
  legend = rownames(fol_region),
  fill = foliage_colors[rownames(fol_region)],
  bty = "n",
  cex = 0.75
)

```

Using percentages in @fig-us-bar-foliage-region prevents the South's larger sample from dominating the comparison. Deciduous Broadleaf remains the largest group everywhere, although its share varies greatly. Evergreen Broadleaf reaches its largest regional shares in the South and West, while Evergreen Needleleaf is especially prominent in the West. Deciduous Needleleaf occurs in every region but never exceeds a little over 1%. Regional climate is one plausible contributor to these differences.

```{r}
#| label: fig-us-ridge-latitude
#| fig-cap: "Latitude profiles of the foliage categories"
#| fig-cap-location: bottom
#| fig-height: 6.5

types <- names(sort(table(us_df$level0), decreasing=FALSE))
plot(NA,xlim=c(18,70),ylim=c(.7,length(types)+1),axes=FALSE,
     xlab="Latitude",ylab="")
axis(1,at=seq(20,65,5),labels=paste0(seq(20,65,5),"°N"))
abline(v=seq(20,65,5),col="grey90",lty=3)
for(i in seq_along(types)){
  z <- us_df$latitude[us_df$level0==types[i]]
  den <- density(z,from=18,to=68,bw=2)
  yy <- i + .8*den$y/max(den$y)
  polygon(c(den$x,rev(den$x)),c(rep(i,length(den$x)),rev(yy)),
          col=adjustcolor(foliage_colors[types[i]],alpha.f=.7),border="white")
  text(69,i,types[i],pos=2,cex=.82,font=2)
}
box()
```

The curves in @fig-us-ridge-latitude overlap, but their peaks occur in different places. Evergreen Broadleaf has a clear southern component, including Hawaii, whereas Evergreen Needleleaf is weighted toward the northern half of the country. Deciduous Broadleaf covers the broadest span of the contiguous states. Deciduous Needleleaf is much less frequent but is not absent: its pink curve has concentrations around 30°N and 45°N.

These shifts support the idea that climate helps structure foliage type. Moving north usually changes temperature, season length, and frost exposure. Still, latitude does not measure climate directly, and other factors—precipitation, elevation, soil, land use, historical range, and sampling density—change at the same time. The figure therefore provides evidence of association, not a causal estimate.

## Taxonomic richness by region

Taxonomic richness is measured here at three levels: family, genus, and species. Simple totals are useful, but they favor regions with more observations because additional records create more opportunities to encounter a new taxon.

@tbl-us-taxa-region and @fig-us-richness-region present the unadjusted counts. @fig-us-rarefaction then places the regions on a common sampling scale. The last visualization, @fig-us-species-ranges, changes the question from “how many species?” to “how geographically concentrated is each common species?”

```{r}
#| label: tbl-us-taxa-region
#| tbl-cap: "Recorded taxonomic diversity and sample size by region"
#| tbl-cap-location: bottom

taxa_region <- as.data.frame(us_df[, .(
  Foliage=uniqueN(level0),
  Families=uniqueN(level1_family),
  Genera=uniqueN(level2_genus),
  Species=uniqueN(level3_species),
  Observations=.N
), by=.(Region=region)])
taxa_region <- taxa_region[order(-taxa_region$Observations),]
knitr::kable(taxa_region,row.names=FALSE)
```

```{r}
#| label: fig-us-richness-region
#| fig-cap: "Unadjusted family, genus, and species counts by region"
#| fig-cap-location: bottom
#| fig-height: 5.5

rich_mat <- t(as.matrix(taxa_region[,c("Families","Genera","Species")]))
colnames(rich_mat) <- taxa_region$Region
barplot(rich_mat,beside=TRUE,border=NA,
        col=c("#56B4E9","#009E73","#E69F00"),
        ylab="Number of distinct taxa",las=2)
legend("topright",legend=rownames(rich_mat),
       fill=c("#56B4E9","#009E73","#E69F00"),bty="n")
```

The South leads the raw counts in @tbl-us-taxa-region and @fig-us-richness-region, followed by the West. Their advantage is partly expected because these are also the two largest regional subsets. Despite having fewer observations, the Northeast and Midwest still include a notable share of the 3,001 species recorded for the United States.

```{r}
#| label: fig-us-rarefaction
#| fig-cap: "Growth of recorded species richness as regional sample size increases"
#| fig-cap-location: bottom
#| fig-height: 6

set.seed(42)
plot(NA,xlim=c(0,max(table(us_df$region))),ylim=c(0,length(unique(us_df$level3_species))),
     xlab="Number of observations",ylab="Expected number of species")
grid(col="grey90")
for(r in levels(us_df$region)){
  sp <- us_df$level3_species[us_df$region==r]
  steps <- unique(round(seq(1,length(sp),length.out=min(80,length(sp)))))
  curves <- replicate(20,{
    ord <- sample(sp)
    cum <- cumsum(!duplicated(ord))
    cum[steps]
  })
  lines(steps,rowMeans(curves),lwd=2.2,col=region_colors[r])
}
legend("bottomright",legend=levels(us_df$region),col=region_colors,lwd=2.2,bty="n")
```

In @fig-us-rarefaction, regions can be compared at the same horizontal position and therefore at the same number of sampled records. The curves reveal how quickly additional observations continue to add species in each region. Comparing them at a shared sample size separates part of the diversity pattern from the very different regional record totals.

```{r}
#| label: fig-us-species-ranges
#| fig-cap: "Observed ranges of the 12 most frequent species in the contiguous states"
#| fig-cap-location: bottom
#| fig-height: 9

top_species <- names(head(sort(table(conus$level3_species),decreasing=TRUE),12))
op <- par(mfrow=c(4,3),mar=c(1.5,1.5,2,.5),oma=c(2,2,0,0))
for(sp in top_species){
  z <- conus[conus$level3_species==sp,]
  draw_conus()
  points(z$longitude,z$latitude,pch=16,cex=.45,
         col=adjustcolor("#173F35",alpha.f=.55))
  title(sp,cex.main=.68)
}
mtext("Longitude",1,outer=TRUE);mtext("Latitude",2,outer=TRUE)
par(op)
```

There is no single answer to whether members of one species grow together. In @fig-us-species-ranges, several species are restricted to compact clusters on the Pacific coast, in Texas, Florida, or the Northeast, while others extend across several states or regions. Each species has its own observed range, but that range may be broad or discontinuous. Environmental requirements and dispersal history matter, and the gaps may also reflect missing observations.

## Changes in the distribution over time

All previous figures combine ten collection years into one picture. This can hide changes in participation, especially for data coming mainly from citizen-science platforms.

The bars and line in @fig-us-obs-per-year compare annual volume with the number of represented states. @fig-us-obs-per-year-region identifies which parts of the country produce the increase, and @fig-us-maps-periods checks whether later records spread into new territory or reinforce existing hotspots.

```{r}
#| label: fig-us-obs-per-year
#| fig-cap: "Annual U.S. record volume and number of represented states"
#| fig-cap-location: bottom
#| fig-height: 6

years <- sort(unique(us_df$year))
year_obs <- sapply(years,function(y)sum(us_df$year==y))
year_states <- sapply(years,function(y)length(unique(us_df$state[us_df$year==y])))
coef <- max(year_obs)/max(year_states)
par(mar=c(5,5,2,5))
barplot(year_obs,names.arg=years,col=adjustcolor("steelblue",alpha.f=.65),
        border=NA,ylab="Number of observations",xlab="Year")
par(new=TRUE)
plot(seq_along(years),year_states,type="b",pch=16,lwd=2,col="firebrick",
     axes=FALSE,xlab="",ylab="",ylim=c(0,max(year_states)*1.1))
axis(4,col.axis="firebrick");mtext("Distinct states",side=4,line=3,col="firebrick")
```

The annual series in @fig-us-obs-per-year rises markedly after 2018 and reaches its highest level near the end of the period. State coverage expands earlier and then changes much less. In other words, recent growth mostly adds records within an already broad national footprint. It indicates greater data-collection activity, not rapid growth in the tree population.

```{r}
#| label: fig-us-obs-per-year-region
#| fig-cap: "Yearly observation counts separated by U.S. region"
#| fig-cap-location: bottom
#| fig-height: 6

yr <- table(us_df$year,us_df$region)
matplot(as.numeric(rownames(yr)),yr,type="o",pch=16,lty=1,lwd=2,
        col=region_colors[colnames(yr)],xlab="Year",ylab="Number of observations")
grid(col="grey90")
legend("topleft",legend=colnames(yr),col=region_colors[colnames(yr)],
       pch=16,lwd=2,bty="n")
```

The regional lines in @fig-us-obs-per-year-region do not grow in parallel. Most of the national increase comes from the South and West, whereas the Northeast and Midwest stay at lower levels. The regional imbalance is therefore repeated across several collection years rather than being produced by one exceptional year.

```{r}
#| label: fig-us-maps-periods
#| fig-cap: "Spatial coverage of U.S. observations across five collection periods"
#| fig-cap-location: bottom
#| fig-height: 10

us_df$period <- ifelse(us_df$year %in% c(2015,2016),"2015–2016",
             ifelse(us_df$year %in% c(2017,2018),"2017–2018",
             ifelse(us_df$year %in% c(2019,2020),"2019–2020",
             ifelse(us_df$year %in% c(2021,2022),"2021–2022","2023–2024"))))
periods <- c("2015–2016","2017–2018","2019–2020","2021–2022","2023–2024")
op <- par(mfrow=c(3,2),mar=c(1.5,1.5,2,.5),oma=c(2,2,0,0))
for(p in periods){
  z <- conus[conus$year %in% as.numeric(unlist(strsplit(p,"–")))[1]:
                           as.numeric(unlist(strsplit(p,"–")))[2],]
  draw_conus()
  points(z$longitude,z$latitude,pch=16,cex=.3,
         col=adjustcolor(foliage_colors[z$level0],alpha.f=.45))
  title(p,cex.main=.9)
}
plot.new()
mtext("Longitude",1,outer=TRUE);mtext("Latitude",2,outer=TRUE)
par(op)
```

The period maps in @fig-us-maps-periods repeatedly show the same geographical cores, although the number of visible points increases. Coverage becomes denser more often than it becomes geographically broader. The dataset thus preserves a similar internal bias throughout the decade.

# Overall Interpretation

This report has examined the GlobalGeoTree dataset from multiple angles — source bias, temporal trends, taxonomic composition, worldwide distribution, regional patterns in Germany, and a country-level analysis of the United States.

**Source bias and temporal trends.** The global analysis showed that citizen-science platforms — above all iNaturalist — dominate the dataset and strongly shape patterns by observation year and geography, making the combined dataset a composite of several geographically non-uniform "lenses" rather than a single coherent survey.

**Taxonomic composition and worldwide distribution.** The taxonomic analysis showed that Deciduous Broadleaf is the largest foliage category in the observations and that recorded species richness peaks in several temperate latitude bands. Sampling is heavily concentrated in North America and Europe, while regions such as central Africa, the Amazon interior, and Central Asia remain sparsely represented. This geographic bias is visible throughout 2015–2024 observation years, with later-dated records tending to intensify already represented areas rather than adding major new regions.

**Germany and Berlin analysis.** Within Germany, citizen-science dominance reproduces at the national level, but not with the same platforms: Pl\@ntNet auto ID leads in Germany where iNaturalist leads globally, and Berlin reverts to iNaturalist again — each scale has a different dominant source. Federal state counts vary widely and closely follow the states' populations, though the report does not normalise by population or area and so cannot separate tree cover from observer density. Berlin proves to be an extreme case: recording concentrates on a single forest, Grunewald, rather than on the urban tree stock a city-state might suggest, and Baden-Württemberg and NRW show this concentration is Berlin-specific. The Berlin oak analysis shows why GlobalGeoTree cannot support pest surveillance alone — the oak records track observer effort, so they are usable only over an official inventory with known coverage. Part II also surfaces a taxonomic fault inherited from the source dataset: roughly a tenth of German records carry family-rank keys behind species-looking names, and a bird ranks among the most-recorded "tree species".

**United States.** The US analysis — the most-represented country in the dataset — showed strong regional imbalance in recording intensity, with the South and West contributing the largest shares of observations. Foliage composition varies geographically: Deciduous Broadleaf dominates everywhere, while Evergreen Broadleaf is more southern/coastal and Evergreen Needleleaf is more western and northern. Taxonomic richness remains partly shaped by sample size, so regional diversity comparisons should be read alongside the rarefaction results.

**Limitations and outlook.** All visualisations in this report show **recording intensity** in the dataset, not a direct census of trees. High values can reflect true tree presence, but they equally reflect where observers and platforms are most active. For any analysis built on GlobalGeoTree, the source composition of the sample should be reported alongside geographic, temporal, or taxonomic results, and key findings should be checked with and without the largest citizen-science source. Future work could refine the source classification rules, particularly for non-English source names, and explore whether the patterns observed in this analysis hold when the dominant citizen-science sources are excluded as a sensitivity check.

GlobalGeoTree aggregates tree observations from a large number of independent sources: citizen-science platforms, institutional herbarium and museum collections, systematic field inventories, compiled floristic atlases, and various research and conservation projects.

Because GlobalGeoTree is assembled from many independent sources, it does not reflect a systematic global sampling design — it reflects where people happened to record trees. The result is a dataset with strong geographic, taxonomic, and temporal biases that are source-driven rather than biologically meaningful.

The dataset has no systematic global sampling design, so observation patterns must not be interpreted as direct measures of tree abundance. Every record reaches the dataset through GBIF, so a single observation re-published by more than one contributing dataset may appear under different source names despite the de-duplication the authors applied; source classification is based on keyword rules and remains uncertain for multilingual or opaque source names; and the `year` field describes when an observation was recorded, not necessarily when it was added to GlobalGeoTree. These limitations apply throughout the report.

# Visualisation Techniques {.unnumbered}

The report intentionally uses multiple visual encodings, including complementary views of the same question. The table summarises the main techniques and what each contributes.

| Technique | Main visual purpose |
|------------------------------------|------------------------------------|
| Bar and stacked-bar charts | Compare rankings, totals, and within-group composition |
| Line and area charts | Show changes across observation years and their source composition |
| Histograms and density curves | Contrast absolute frequency with distribution shape |
| Boxplots, heatmaps, and ridge plots | Compare distributions across taxa and latitude |
| Point and faceted maps | Show coverage, individual locations, and group-specific footprints |
| KDE maps and spatial bins | Emphasise relative hotspots and local concentration |
| Choropleth maps | Compare aggregated counts across administrative areas |
| Richness grids and rarefaction curves | Compare recorded taxonomic richness spatially and at equal observation counts |
| Spatial joins | Connect observation coordinates with continents and administrative boundaries |

